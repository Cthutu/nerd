Info :: plex { value i32 }
CreateInfo :: plex { info ^Info }
main :: fn () {
    pointer := ^Info { value: 7 }
    create := CreateInfo { info: ^{ value: 11 } }
    assert pointer.value == 7
    assert create.info.value == 11
}
