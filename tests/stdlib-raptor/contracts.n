use std.io
use std.queue
use std.raptor
use std.sync
use std.thread

Gate :: plex {
    mutex    Mutex
    changed  Condition
    entered  bool
    released bool
}

gated :: fn (context: ^void) -> i32 {
    gate := context.as(^Gate)
    assert gate.mutex.lock()
    gate.entered = yes
    assert gate.changed.broadcast()
    for !gate.released {
        assert gate.changed.wait(^gate.mutex)
    }
    assert gate.mutex.unlock()
    return 42
}

value :: fn (context: ^void) -> i32 {
    return context.as(^i32)^
}

nothing :: fn (context: ^void) {
    context.as(^i32)^ += 1
}

Nested :: plex {
    queue     ^Queue
    task      ^Task[i32]
    serial    ^Task[i32]
    scheduler ^Scheduler
    number    i32
}

nested_child :: fn (context: ^void) -> i32 {
    state := context.as(^Nested)
    assert !state.task.wait()
    return 17
}

nested :: fn (context: ^void) -> i32 {
    state := context.as(^Nested)
    assert !state.task.wait()
    assert !state.scheduler.close()
    child  : Task[i32]
    number : i32       = 17

    assert child.async(state.queue, value, (^number).as(^void))
    on child.get() {
        result  => return result + 1
        else    => return -1
    }
}

serial_wait :: fn (context: ^void) -> i32 {
    state := context.as(^Nested)
    state.number = 8
    assert state.serial.async(state.queue, value, (^state.number).as(^void))
    assert !state.serial.wait()
    return 1
}

SerialState :: plex {
    next   i32
    active bool
}

SerialItem :: plex {
    state ^SerialState
    index i32
}

serial_item :: fn (context: ^void) {
    item := context.as(^SerialItem)
    assert !item.state.active
    item.state.active = yes
    assert item.state.next == item.index
    item.state.next += 1
    item.state.active = no
}

Stealing :: plex {
    queue ^Queue
    gate  ^Gate
    child ^Task[void]
}

release_gate :: fn (context: ^void) {
    gate := context.as(^Gate)
    assert gate.mutex.lock()
    gate.released = yes
    assert gate.changed.broadcast()
    assert gate.mutex.unlock()
}

steal_parent :: fn (context: ^void) {
    state := context.as(^Stealing)
    assert state.gate.mutex.lock()
    assert state.child.async(state.queue, release_gate, state.gate.as(^void))
    -- Parent pins its worker until another worker steals the locally submitted job.
    for !state.gate.released {
        assert state.gate.changed.wait(^state.gate.mutex)
    }
    assert state.gate.mutex.unlock()
    assert state.child.wait()
}

Producer :: plex {
    queue  ^Queue
    tasks  [32]Task[i32]
    values [32]i32
}

produce :: fn (context: ^void) {
    producer := context.as(^Producer)
    for i in [0 .. 32] {
        producer.values[i] = i.as(i32)
        assert producer.tasks[i].async(producer.queue, value, (^producer.values[i]).as(^void))
    }
    assert when_all((^producer.tasks[0]).as([]Task[i32], 32))
    for i in [0 .. 32] {
        on producer.tasks[i].get() {
            result => {
                assert result == i.as(i32)
            }

            else => {
                assert no
            }
        }
    }
}

Removal :: plex {
    deque   ^void
    gate    ^Gate
    thief   bool
    claimed ^void
}

remove_one :: fn (context: ^void) {
    state := context.as(^Removal)
    assert state.gate.mutex.lock()
    for !state.gate.released {
        assert state.gate.changed.wait(^state.gate.mutex)
    }
    assert state.gate.mutex.unlock()
    deque := state.deque.as(^WorkDeque[^void])
    on state.thief => {
        on deque.steal() {
            p => {
                state.claimed = p
            }

            else => {
            }
        }
    } else {
        on deque.pop() {
            p => {
                state.claimed = p
            }

            else => {
            }
        }
    }
}

main :: fn () -> i32 {
    slots   : [3]^void
    deque   : WorkDeque[^void]
    numbers                    := [1, 2, 3, 4]

    assert deque.init((^slots[0]).as([]^void, 3))
    assert deque.pop() == nil
    assert deque.steal() == nil
    for i in [0 .. 3] {
        assert deque.push((^numbers[i]).as(^void))
    }
    assert !deque.push((^numbers[3]).as(^void))
    on deque.pop() {
        p => {
            assert p.as(^i32)^ == 3
        }

        else => {
            assert no
        }
    }
    on deque.steal() {
        p => {
            assert p.as(^i32)^ == 1
        }

        else => {
            assert no
        }
    }
    assert deque.push((^numbers[3]).as(^void))
    on deque.steal() {
        p => {
            assert p.as(^i32)^ == 2
        }

        else => {
            assert no
        }
    }
    on deque.pop() {
        p => {
            assert p.as(^i32)^ == 4
        }

        else => {
            assert no
        }
    }
    race_gate : Gate
    assert race_gate.mutex.init()
    assert race_gate.changed.init()
    for _iteration in [0 .. 32] {
        race_gate.released = no
        assert deque.push((^numbers[0]).as(^void))
        owner                 := Removal { deque: (^deque).as(^void) gate: ^race_gate ... }
        thief                 := Removal { deque: (^deque).as(^void) gate: ^race_gate thief: yes ... }
        owner_thread : Thread
        thief_thread : Thread

        assert owner_thread.start(remove_one, (^owner).as(^void))
        assert thief_thread.start(remove_one, (^thief).as(^void))
        assert race_gate.mutex.lock()
        race_gate.released = yes
        assert race_gate.changed.broadcast()
        assert race_gate.mutex.unlock()
        assert owner_thread.join()
        assert thief_thread.join()
        assert (owner.claimed != nil) != (thief.claimed != nil)
        assert deque.pop() == nil
    }
    assert race_gate.changed.done()
    assert race_gate.mutex.done()
    assert deque.done()

    scheduler : Scheduler
    assert scheduler.close()
    assert !scheduler.init(0)
    assert !scheduler.init(1, capacity = 0)
    assert scheduler.init(1, capacity = 2)
    assert !scheduler.init(1)
    queue                                := scheduler.get_default_queue()
    idle    : Task[i32]
    missing : fn (context: ^void) -> i32

    assert !idle.wait()
    assert !idle.async(queue, missing, nil)
    parent : Task[i32]
    state              := Nested { queue task: ^parent scheduler: ^scheduler ... }

    assert parent.async(queue, nested, (^state).as(^void))
    on parent.get() {
        result => {
            assert result == 18
        }

        else => {
            assert no
        }
    }
    assert parent.has_finished()
    assert !parent.async(queue, nested, (^state).as(^void))
    assert scheduler.close()
    assert parent.wait()
    assert !idle.async(queue, value, nil)

    gate : Gate
    assert gate.mutex.init()
    assert gate.changed.init()
    assert scheduler.init(1, capacity = 2)
    first    : Task[i32]
    second   : Task[i32]
    rejected : Task[i32]

    assert first.async(scheduler.get_default_queue(), gated, (^gate).as(^void))
    assert gate.mutex.lock()
    for !gate.entered {
        assert gate.changed.wait(^gate.mutex)
    }
    number : i32 = 7
    assert second.async(scheduler.get_default_queue(), value, (^number).as(^void))
    assert !rejected.async(scheduler.get_default_queue(), value, (^number).as(^void))
    assert !rejected.wait()
    gate.released = yes
    assert gate.changed.broadcast()
    assert gate.mutex.unlock()
    assert first.wait()
    assert second.wait()
    mixed : [2]Task[i32]
    assert mixed[1].async(scheduler.get_default_queue(), value, (^number).as(^void))
    assert !when_all[i32](mixed[..])
    assert mixed[1].has_finished()
    assert rejected.async(scheduler.get_default_queue(), value, (^number).as(^void))
    assert scheduler.close()
    on rejected.get() {
        result => {
            assert result == 7
        }

        else => {
            assert no
        }
    }

    gate.released = no
    assert scheduler.init(2, capacity = 8)
    child    : Task[void]
    stealing              := Stealing { queue: scheduler.get_default_queue() gate: ^gate child: ^child }
    root     : Task[void]

    assert root.async(stealing.queue, steal_parent, (^stealing).as(^void))
    assert root.wait()
    assert scheduler.mutex.lock()
    assert scheduler.steals > 0
    assert scheduler.mutex.unlock()
    assert scheduler.close()
    assert gate.changed.done()
    assert gate.mutex.done()

    assert scheduler.init(4, capacity = 64)
    serial : Queue
    assert scheduler.create_queue(^serial, QueueType.Serial)
    assert !scheduler.create_queue(^serial, QueueType.Serial)
    sequence : SerialState
    items    : [64]SerialItem
    tasks    : [64]Task[void]

    for i in [0 .. 64] {
        items[i] = SerialItem { state: ^sequence index: i.as(i32) }
        assert tasks[i].async(^serial, serial_item, (^items[i]).as(^void))
    }
    assert when_all((^tasks[0]).as([]Task[void], 64))
    assert sequence.next == 64
    serial_parent : Task[i32]
    serial_child  : Task[i32]
    serial_state              := Nested { queue: ^serial serial: ^serial_child scheduler: ^scheduler ... }

    assert serial_parent.async(^serial, serial_wait, (^serial_state).as(^void))
    assert serial_parent.wait()
    on serial_child.get() {
        result => {
            assert result == 8
        }

        else => {
            assert no
        }
    }
    count     : i32
    void_task : Task[void]

    assert void_task.async(scheduler.get_default_queue(), nothing, (^count).as(^void))
    assert void_task.get() != nil
    assert count == 1
    producers : [4]Producer
    threads   : [4]Thread

    for i in [0 .. 4] {
        producers[i].queue = scheduler.get_default_queue()
        assert threads[i].start(produce, (^producers[i]).as(^void))
    }
    for i in [0 .. 4] {
        assert threads[i].join()
    }
    assert scheduler.close()
    assert sequence.next == 64
    assert scheduler.close()
    prn("Raptor deque, stealing, serial, nested waits, producers and drain passed")
    return 0
}
