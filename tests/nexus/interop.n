use std.nexus

on "linux" {

    ffi "c" {
        fflush (stream: ^void) -> i32
    }

}

on "windows" {

    ffi "msvcrt" {
        fflush (stream: ^void) -> i32
    }

}

exchange :: fn (socket: ^NetSocket) -> void\NexusError {
    message := Message.create(socket)
    defer message.done()
    message.recv()?
    assert message.read_u8()? == 0x12
    assert message.read_u16()? == 0x3456
    assert message.read_u32()? == 0x789abcde
    assert message.read_u64()? == 0xfedcba9876543210
    assert message.read_string()? == "nexus"
    assert message.read_string()? == ""
    assert message.payload().count == 0
    message.clear()
    message.append_u8(0x12)?
    message.append_u16(0x3456)?
    message.append_u32(0x789abcde)?
    message.append_u64(0xfedcba9876543210)?
    message.append_string("nexus")?
    message.append_string("")?
    message.send()?
    message.recv()?
    assert message.payload().count == 0
    message.send()?
}

serve :: fn () -> void\NexusError {
    server := net_socket()
    defer server.close()
    server.bind("tcp://127.0.0.1:0")?
    server.set_option(NetOption.SendTimeoutMs, 5000)
    server.set_option(NetOption.RecvTimeoutMs, 5000)
    address := server.local_address()?
    prn($"{address.port}")
    _ := fflush(nil)
    exchange(^server)?
}

main :: fn () -> i32 {
    on serve() {
        _! => {
            return 1
        } else => {
        }
    }
    prn("Nexus TCP C interoperability passed")
    return 0
}
