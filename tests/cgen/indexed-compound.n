State :: plex { values [3]u64 index usize }
update :: fn (state: ^State) {
    state.values[state.index] += 7
    state.values[state.index] -= 2
    state.values[state.index] *= 3
    state.values[state.index] /= 5
    state.values[state.index] %= 4
    state.values[state.index] |= 8
    state.values[state.index] &= 11
    state.values[state.index] ~= 3
    state.values[state.index] <<= 1
    state.values[state.index] >>= 1
}
main :: fn () {
    state : State
    state.values[0] = 2
    update(^state)
    assert state.values[0] == 11
    values := [1, 2, 3]
    slice := values[..]
    slice[1] += 5
    pointer := values.data
    pointer[2] -= 1
    assert values[1] == 7 && values[2] == 2
    dynamic : [..]i32
    defer dynamic.free()
    dynamic.push(10)
    dynamic[0] += 32
    assert dynamic[0] == 42
    flags := [no, yes]
    flags[0] ||= yes
    flags[1] &&= no
    assert flags[0] && !flags[1]
}
