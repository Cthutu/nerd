-- Nonblocking TCP with deadlines: connect a loopback pair and echo bytes while
-- explicitly waiting for socket readiness. Nonblocking I/O can return
-- WouldBlock instead of sleeping; readiness says an operation may now make
-- progress. One absolute monotonic deadline bounds setup and all retries in
-- this exchange.

use std.network
use std.time

-- One absolute deadline covers every partial write and readiness retry.
send_bytes :: fn (stream: ^Socket, bytes: []u8, deadline: Instant) -> void\NetworkError {
    offset : usize = 0
    -- A writable readiness entry permits a send attempt; it does not promise
    -- that the whole remaining buffer fits. Reuse the same absolute deadline.
    entries := [PollEntry {
        socket: stream write: yes ...
    }
    ]
    for offset < bytes.count {
        on now() >= deadline => return NetworkError.TimedOut {
            code: 0
        }!
        on poll(entries[..], deadline = deadline)? == 0 => return NetworkError.TimedOut {
            code: 0
        }!
        -- Advance only by bytes actually sent. If readiness became stale and send
        -- reports WouldBlock, wait again without duplicating the accepted prefix.
        on stream.send(bytes[offset ..]) {
            count => {
                on count == 0 => return NetworkError.Invalid!
                offset += count
            }
            NetworkError.WouldBlock {
                code
            }
            ! => {
                _ := code
            }
            error! => return error!
        }
    }
}

-- Readiness is a hint; nonblocking receive may still report WouldBlock.
receive_bytes :: fn (stream: ^Socket, bytes: []u8, deadline: Instant) -> void\NetworkError {
    offset : usize = 0
    entries := [PollEntry {
        socket: stream read: yes ...
    }
    ]
    for offset < bytes.count {
        on now() >= deadline => return NetworkError.TimedOut {
            code: 0
        }!
        on poll(entries[..], deadline = deadline)? == 0 => return NetworkError.TimedOut {
            code: 0
        }!
        -- A readable socket may contain data or report EOF. This fixed-size protocol
        -- expects more bytes, so EOF before the buffer is filled is an error.
        on stream.receive(bytes[offset ..]) {
            received => {
                on received.eof => return NetworkError.Invalid!
                offset += received.count
            }
            NetworkError.WouldBlock {
                code
            }
            ! => {
                _ := code
            }
            error! => return error!
        }
    }
}

-- Set up both endpoints locally; no fixed port, external server or startup
-- sleep is needed. Connected endpoints are switched to nonblocking operation.
run_echo :: fn () -> void\NetworkError {
    listener := socket(SocketKind.Tcp)?
    defer _ := listener.close()
    listener.bind(loopback(0))?
    listener.listen()?
    listener.nonblocking(yes)?
    address := listener.local_address()?
    -- An absolute deadline is a clock instant, not a fresh duration for each
    -- operation. Reusing it prevents retries from extending the total timeout.
    deadline := now().add(from_secs(2))

    client := socket(SocketKind.Tcp)?
    defer _ := client.close()
    client.nonblocking(yes)?
    -- Nonblocking connect may be pending. finish_connect waits for readiness
    -- and checks the socket error before treating the connection as established.
    _ := client.start_connect(address)?
    on !client.finish_connect(deadline = deadline)? => return NetworkError.TimedOut { code: 0 }!
    entries := [PollEntry { socket: ^listener read: yes ... }]
    on poll(entries[..], deadline = deadline)? == 0 => return NetworkError.TimedOut { code: 0 }!
    -- Listener readiness makes accept worth attempting. The accepted socket
    -- starts in blocking mode, so explicitly enable nonblocking I/O on it too.
    server := listener.accept()?
    defer _ := server.close()
    server.nonblocking(yes)?

    -- The protocol knows this payload's size in advance. Readiness controls when
    -- I/O can proceed; it does not supply message boundaries for the TCP stream.
    message := "hello deadlines".as([]u8)
    send_bytes(^client, message, deadline)?
    request : [15]u8
    receive_bytes(^server, request[..], deadline)?
    send_bytes(^server, request[..], deadline)?
    reply : [15]u8
    receive_bytes(^client, reply[..], deadline)?
    assert reply[..].as(string) == "hello deadlines"
    prn("TCP readiness: hello deadlines")
}

-- Keep error reporting at the outer boundary; deferred socket closes in
-- run_echo cover failures during setup and later I/O.
main :: fn () -> i32 {
    return on run_echo() {
        _! => {
            eprn("TCP readiness failed")
            return 1
        }
        else => 0
    }
}
