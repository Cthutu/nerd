-- Small text adventure: describe the current room, read a command, normalise
-- its verb and follow a direction-labelled exit to another room. Locations and
-- exits form a tiny graph stored as data, while player_loc records the current
-- node. Only movement and quitting are handled; the synonym table also sketches
-- future verbs.

use std.io
use std.memory
use std.text
use term

-- Create the world description, then repeat input and dispatch until quit.
main :: fn () {
    state := init()

    show_location(^state)

    for {
        -- The input buffer owns the command text. Splitting creates an owned list
        -- of borrowed string views; both are freed at this iteration's end in reverse
        -- order, after command processing has finished using those views.
        player_input := input("> ")
        defer player_input.free()

        input_parts := player_input.as(string).split(" ")
        defer input_parts.free()
        verb   : string
        _nouns : []string

        on input_parts.count {
            0 => {
                prn("Please enter a command.")
                again
            }

            1 => {
                verb = input_parts[0]
            }

            else => {
                verb   = input_parts[0]
                _nouns = input_parts[1..]
            }
        }

        -- A synonym group maps several spellings to its first, canonical verb.
        -- Movement handling can then use a short list of direction codes.
        -- Normalise verb
        for i, verb_group in state.verbs {
            for verb_synonym in verb_group^ {
                on verb == verb_synonym^ => verb = state.verbs[i][0]
            }
        }

        -- Dispatch implemented actions. Parsed nouns are reserved for future commands;
        -- a recognised synonym alone does not mean its action has been implemented.
        on verb {
            "q", "quit" => {
                prn("Goodbye!")
                break
            }

            "n", "s", "e", "w", "u", "d" => move(^state, verb)

            else => {
                prn("I don't understand that command.")
            }
        }
    }

    -- The loop's input allocations have been released before this diagnostic.
    -- The static world tables are borrowed data, not per-command allocations.
    print_leaks(show_message_on_no_leaks = yes)
}

-- Display the room text wrapped to terminal width, then list its outgoing
-- edges.
show_location :: fn (state: ^State) {
    prn_wrap($"{state.locations[state.player_loc]}")
    prn()
    show_exits(state)
}

-- Search only the current room's exits. A matching edge updates the room index;
-- the loop's else handles the case where no direction matched.
move :: fn (state: ^State, direction: string) {
    for exit in state.exits[state.player_loc] {
        on exit.0 == direction => {
            state.player_loc = exit.1
            show_location(state)
            break
        }
    }
    else {
        prn("You can't go that way.")
    }
}

-- The world tables are read-only views of literal data. Only player_loc changes
-- during play; integer room indices connect the exit table to descriptions.
State :: plex {
    -- Database
    locations  []string    -- location descriptions
    exits      [][](string, usize)
    verbs      [][]string  -- verbs and their synonyms

    -- Game state
    player_loc usize
}

-- Translate compact direction codes to friendly labels when presenting choices.
show_exits :: fn (state: ^State) {
    pr("Exits: ")
    for i, exit in state.exits[state.player_loc] {
        pr($"{exit_strings(exit.0)}")
        on i < state.exits[state.player_loc].count - 1 => pr(", ") else pr(".")
    }
    prn()
    prn()
}

-- Describe each room once and list its (direction, destination-index) edges.
-- Changing these tables extends the world without changing the command loop.
init :: fn () -> State {
    return {
        locations: [
            "I am in a Hall.  The Kitchen is to the East, the Bedroom to the West and the Lounge to the South.  Steps lead Down to the Cellar.",
            "I am in the Kitchen.  The Hall is to the West and the Dining room is to the South.",
            "I am in the Dining room.  The Kitchen is to the North and the Lounge is to the West.",
            "I am in the Lounge.  To the North is the Hall while the Dining room is to the East.",
            "I am in the Bedroom.  The Hall is to the East and a bed is against the North wall.",
            "I am in the Cellar.  Steps lead Up to the Hall.",
        ]
        exits: [
            [
                ("e", 1),
                ("w", 4),
                ("s", 3),
                ("d", 5),
            ],
            [
                ("w", 0),
                ("s", 2),
            ],
            [
                ("n", 1),
                ("w", 3),
            ],
            [
                ("n", 0),
                ("e", 2),
            ],
            [
                ("e", 0),
            ],
            [
                ("u", 0),
            ],
        ]
        verbs: [
            [
                "n",
                "north",
            ],
            ["s", "south"],
            ["e", "east"],
            ["w", "west"],
            ["u", "up"],
            ["d", "down"],
            ["look", "l"],
            ["quit", "q"],
            ["i", "inv", "inventory"],
            ["get", "take"],
            ["drop"],
        ]
        player_loc: 0
    }
}

-- Keep display names separate from the compact codes used by the game logic.
exit_strings :: fn (exit: string) -> string {
    return on exit {
        "n"   => "North"
        "s"   => "South"
        "e"   => "East"
        "w"   => "West"
        "u"   => "Up"
        "d"   => "Down"
        else  => exit
    }
}
