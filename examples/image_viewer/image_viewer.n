-- Embedded image viewer: decode a bundled JPEG to RGBA pixels, fit it into a
-- logical pixel layer without changing its aspect ratio and present it in a
-- window. Image decoding produces owned CPU memory; std.gfx supplies the
-- display layer. A checkerboard supports transparent images too, although the
-- selected JPEG is opaque.

use std.frame
use std.gfx
use std.image
use std.time

-- Changing this constant reverses source rows when the image is drawn.
IMAGE_VIEWER_FLIP_VERTICALLY :: no

-- Find the largest centred rectangle that fits the view while preserving the
-- image's width-to-height ratio. The remaining area becomes a letterbox border.
image_view_rect :: fn (view_width   : u32,
                       view_height  : u32,
                       image_width  : u32,
                       image_height : u32) -> PixelRect {
    on image_width == 0 ||
        image_height == 0 ||
        view_width == 0 ||
        view_height == 0 => return PixelRect { x: 0 y: 0 width: 0 height: 0 }

    width_from_height := (view_height * image_width) / image_height
    draw_width        := view_width
    draw_height       := (view_width * image_height) / image_width

    on draw_height > view_height => {
        draw_width  = width_from_height
        draw_height = view_height
    }

    on draw_width == 0 => draw_width = 1
    on draw_height == 0 => draw_height = 1

    return PixelRect {
        x      : (view_width - draw_width) / 2
        y      : (view_height - draw_height) / 2
        width  : draw_width
        height : draw_height
    }
}

-- Alternating dark tiles make transparency visible when loading an alpha image.
image_checkerboard :: fn (x: u32, y: u32) -> u32 {
    tile := ((x / 8) + (y / 8)) & 1
    return on tile == 0 => 0xff2a2a2a else 0xff3a3a3a
}

-- Alpha expresses opacity from 0 to 255. Mix each source colour channel with
-- the background using that opacity, then produce an opaque display colour.
image_blend_over :: fn (red        : u32,
                        green      : u32,
                        blue       : u32,
                        alpha      : u32,
                        background : u32) -> u32 {
    on alpha == 255 => return 0xff000000 | (red << 16) | (green << 8) | blue

    background_red   := (background >> 16) & 0xff
    background_green := (background >> 8) & 0xff
    background_blue  := background & 0xff

    out_red   := (red * alpha + background_red * (255 - alpha)) / 255
    out_green := (green * alpha + background_green * (255 - alpha)) / 255
    out_blue  := (blue * alpha + background_blue * (255 - alpha)) / 255

    return 0xff000000 | (out_red << 16) | (out_green << 8) | out_blue
}

-- The decoder was asked for four channels per pixel, so RGBA pixels occupy four
-- consecutive bytes. Clamp sample coordinates to stay inside the image.
image_pixel :: fn (image: ^Image, x: u32, y: u32, background: u32) -> u32 {
    on image.width == 0 || image.height == 0 => return background

    clamped_x := on x < image.width.as(u32) => x else image.width.as(u32) - 1
    clamped_y := on y < image.height.as(u32) => y else image.height.as(u32) - 1
    index     := ((clamped_y * image.width.as(u32) + clamped_x) * 4).as(usize)

    return image_blend_over(image.data[index].as(u32),
                            image.data[index + 1].as(u32),
                            image.data[index + 2].as(u32),
                            image.data[index + 3].as(u32),
                            background)
}

-- @embed includes asset bytes in the executable at compile time. Decoding
-- creates a separate owned Image, so the executable needs no runtime asset
-- path.
load_demo_image :: fn () -> Image {
    bytes  := @embed("assets/demo.jpg")
    result := Image.load_bytes(bytes, desired_channels = 4)

    return on result {
        image  => image
        else   => abort("Could not decode embedded image viewer asset.")
    }
}

-- Clear the layer, calculate the image rectangle and resample into it. Integer
-- coordinate mapping chooses a nearest source pixel rather than interpolating.
draw_image_viewer :: fn (layer: ^PixelLayer, image: ^Image) {
    layer.clear(0xff181818)

    view_width  := layer.pixel_width()
    view_height := layer.pixel_height()

    rect := image_view_rect(view_width,
                            view_height,
                            image.width.as(u32),
                            image.height.as(u32))

    on rect.width == 0 || rect.height == 0 => return

    -- Map destination positions back to source coordinates. This scales the image
    -- without allocating another resized image buffer.
    for y: u32 = 0; y < rect.height; y += 1 {
        source_y := (y * image.height.as(u32)) / rect.height
        on IMAGE_VIEWER_FLIP_VERTICALLY => {
            source_y = image.height.as(u32) - 1 - source_y
        }
        for x: u32 = 0; x < rect.width; x += 1 {
            source_x   := (x * image.width.as(u32)) / rect.width
            target_x   := rect.x + x
            target_y   := rect.y + y
            background := image_checkerboard(target_x, target_y)

            layer.put(target_x,
                      target_y,
                      image_pixel(image, source_x, source_y, background))
        }
    }

    -- Outline the fitted image rectangle so its boundary and letterboxing are visible.
    layer.fill(PixelRect {
        x      : rect.x
        y      : rect.y
        width  : rect.width
        height : 1
    }, 0xffffffff)
    layer.fill(PixelRect {
        x      : rect.x
        y      : rect.y + rect.height - 1
        width  : rect.width
        height : 1
    }, 0xffffffff)
    layer.fill(PixelRect {
        x      : rect.x
        y      : rect.y
        width  : 1
        height : rect.height
    }, 0xffffffff)
    layer.fill(PixelRect {
        x      : rect.x + rect.width - 1
        y      : rect.y
        width  : 1
        height : rect.height
    }, 0xffffffff)
}

-- Resolve the layer handle and present the freshly drawn image.
render_image_viewer :: fn (gfx    : ^GfxSystem,
                           handle : GfxLayerHandle,
                           frame  : ^Frame,
                           image  : ^Image) -> bool\GfxError {
    layer := (gfx.get_pixel_layer(handle))?
    draw_image_viewer(layer, image)
    gfx.render(frame)
    return yes
}

-- Construct owners in dependency order: frame system, graphics, then image.
-- Their defers release image memory and graphics before disposing of windows.
main :: fn () {
    frame_system := FrameSystem.init()
    defer frame_system.done()

    frame := Frame {
        id          : NEW_FRAME
        width       : 960
        height      : 640
        title       : "Image Viewer"
        full_screen : no
        resizable   : yes
        ...
    }

    frame_system.apply(^frame)

    gfx := GfxSystem.init()
    defer gfx.done()

    image := load_demo_image()
    defer image.free()

    -- Draw into a fixed 320 by 200 logical surface. Window resizing scales that
    -- surface; fitting the source image happens within these logical dimensions.
    layer_handle := gfx.create_pixel_layer(^frame, PixelLayerMode.FixedSizeAutoScale {
        width  : 320
        height : 200
    })

    -- Drain input, redraw and present while the window is active. Q/Escape closes
    -- it and Alt+Enter reapplies full-screen state.
    for frame_system.loop() {
        frame_system.update(^frame)

        for event := frame_system.poll(^frame);
            event != FrameEvent.None;
            event = frame_system.poll(^frame) {
            on event {
                None => {
                }

                Closed => {
                }

                KeyPress { scan_code } => {
                    on scan_code {
                        Escape  => frame_system.close(^frame)
                        Q       => frame_system.close(^frame)

                        Enter => {
                            on frame_system.is_alt_down() => {
                                frame.full_screen = !frame.full_screen
                                frame_system.apply(^frame)
                            }
                        }
                    }
                }
            }
        }

        _ := render_image_viewer(^gfx, layer_handle, ^frame, ^image)

        -- A short pause provides simple loop pacing instead of repeatedly redrawing
        -- as quickly as the CPU can run.
        sleep_ms(16)
    }

    frame_system.close(^frame)
}
