-- Terminal mouse input: display pointer position, button transitions, wheel
-- movement and accumulated counts. Coordinates refer to terminal cells, not
-- image pixels. The simulation callback collects input and presentation draws a
-- dashboard. Q or Escape leaves the terminal loop and restores the visible
-- cursor.

use std.term
use std.time

-- Keep the most recent snapshot and running totals between callbacks.
-- pressed/released are transitions; buttons describes which buttons are held.
mouse         : TermMouse
click_count   : u32
release_count : u32
move_count    : u32
last_x        : i32       = -1
last_y        : i32       = -1
wheel_x       : i32
wheel_y       : i32

-- Button flags form a bit mask: several flags may be set in one snapshot. Count
-- recognised bits rather than treating the mask as one button number.
mouse_button_count :: fn (buttons: u32) -> u32 {
    count : u32 = 0
    on (buttons & TERM_MOUSE_LEFT) != 0 => count += 1
    on (buttons & TERM_MOUSE_RIGHT) != 0 => count += 1
    on (buttons & TERM_MOUSE_MIDDLE) != 0 => count += 1
    on (buttons & TERM_MOUSE_X1) != 0 => count += 1
    on (buttons & TERM_MOUSE_X2) != 0 => count += 1
    return count
}

-- Process the latest simulation input, preserving the old position so the
-- presentation callback can show movement as well as the current pointer.
mouse_simulate :: fn (sim: TermSimulate) {
    on sim.key_pressed(Q) ||
        sim.key_pressed(Escape) => {
        term_done()
        return
    }

    last_x = mouse.x
    last_y = mouse.y
    mouse  = sim.mouse

    on mouse.x != last_x ||
        mouse.y != last_y => {
        move_count += 1
    }

    -- Accumulate transitions and wheel deltas once per simulation callback,
    -- rather than once per redraw, which may run at a different cadence.
    click_count   += mouse_button_count(sim.mouse.pressed)
    release_count += mouse_button_count(sim.mouse.released)
    wheel_x       += sim.mouse.wheel_x
    wheel_y       += sim.mouse.wheel_y
}

-- Rebuild a cell framebuffer from the saved input state. The presentation
-- callback does not consume input or change the accumulated counters.
mouse_present :: fn (present: TermPresent) {
    term_fb_clear()
    term_fb_fill_rect(0,
                      0,
                      present.width,
                      present.height,
                      ch = ' ',
                      ink = rgb(220, 230, 245),
                      paper = rgb(10, 16, 24))
    term_fb_box(0,
                0,
                present.width,
                present.height,
                style = BoxStyle.Rounded,
                ink = rgb(110, 190, 255),
                paper = rgb(10, 16, 24))

    term_fb_text(2,
                 1,
                 "std.term mouse",
                 ink = rgb(255, 245, 180),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 3,
                 $"cell {mouse.x}, {mouse.y}",
                 ink = rgb(220, 230, 245),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 4,
                 $"movement {move_count}  previous {last_x}, {last_y}",
                 ink = rgb(220, 230, 245),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 5,
                 $"buttons {mouse.buttons}  pressed {mouse.pressed}  released {mouse.released}",
                 ink = rgb(190, 225, 205),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 6,
                 $"clicks {click_count}  releases {release_count}",
                 ink = rgb(190, 225, 205),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 7,
                 $"wheel x {wheel_x}  y {wheel_y}",
                 ink = rgb(235, 200, 255),
                 paper = rgb(10, 16, 24))
    term_fb_text(2,
                 present.height.as(i32) - 2,
                 "q / Esc exits",
                 ink = rgb(150, 170, 190),
                 paper = rgb(10, 16, 24))

    -- Draw the old and current positions only when they lie inside the terminal;
    -- negative coordinates can represent a pointer position that is not available.
    on (mouse.x != last_x || mouse.y != last_y) &&
        last_x >= 0 &&
        last_y >= 0 &&
        last_x < present.width.as(i32) &&
        last_y < present.height.as(i32) => {
        term_fb_put(last_x,
                    last_y,
                    '.',
                    ink = rgb(110, 190, 255),
                    paper = rgb(10, 16, 24))
    }

    on mouse.x >= 0 &&
        mouse.y >= 0 &&
        mouse.x < present.width.as(i32) &&
        mouse.y < present.height.as(i32) => {
        term_fb_put(mouse.x,
                    mouse.y,
                    '+',
                    ink = rgb(10, 16, 24),
                    paper = rgb(255, 245, 180))
    }
}

-- Request enough terminal cells for the dashboard and hide the text cursor
-- while our own pointer markers are drawn.
main :: fn () {
    term_init(min_width = 54, min_height = 13)
    term_cursor_enable(no)
    defer term_cursor_enable(yes)

    -- Collect input every 16 ms but redraw every 33 ms. Separating these cadences
    -- keeps input accounting independent of rendering frequency.
    term_hook_simulation(from_ms(16), mouse_simulate)
    term_hook_presentation(from_ms(33), mouse_present)
    term_run()
}
