-- Layer composition: draw an opaque background and a translucent foreground,
-- then let std.gfx combine them in layer creation order. The background fits
-- the window while the foreground keeps a fixed logical size and is scaled to
-- fit. The result demonstrates transparency, independent layer sizes and shared
-- presentation.

use std.frame
use std.gfx
use std.time

-- Generate an opaque pattern, using 0xff in the alpha channel.
background_colour :: fn (x: u32, y: u32, tick: u32) -> u32 {
    band        := ((x / 6) + (y / 6) + (tick / 10)) & 1
    red         := ((x * 3 + tick * 2) & 255) << 16
    green       := ((y * 5 + tick) & 255) << 8
    blue  : u32 = on band == 0 => 0x38 else 0xa8

    return 0xff000000 | red | green | blue
}

-- Generate a coloured pulse with partial alpha. Smaller alpha values allow more
-- of the already-drawn background to show through during composition.
foreground_colour :: fn (x: u32, y: u32, tick: u32) -> u32 {
    cx : u32 = 48
    cy : u32 = 36

    dx          := on x > cx => x - cx else cx - x
    dy          := on y > cy => y - cy else cy - y
    pulse       := (tick / 4) & 31
    ring        := (dx + dy + pulse) & 31
    red         := (220 - ring * 4) << 16
    green       := ((x * 2 + tick * 3) & 255) << 8
    blue        := (80 + ring * 5) & 255
    alpha : u32 = on ring < 8 => 0xe0 else 0x90

    return (alpha << 24) | red | green | blue
}

-- Paint the complete background using the row stride supplied by paint.
draw_background :: fn (layer: ^PixelLayer, tick: u32) {
    layer.paint({
        x      : 0
        y      : 0
        width  : layer.pixel_width()
        height : layer.pixel_height()
    }, fn (pixels: []u32, width: u32, height: u32, stride: u32, user: ^void) {
        tick := (user.as(^u32))^
        for y in [0 .. height] {
            for x in [0 .. width] {
                pixels[y * stride + x] = background_colour(x, y, tick)
            }
        }
    }, user = ^tick)
}

-- Start transparent each frame so old foreground pixels do not persist. Only
-- the circle, borders and bar become visible over the background.
draw_foreground :: fn (layer: ^PixelLayer, tick: u32) {
    layer.clear(0x00000000)

    width  := layer.pixel_width()
    height := layer.pixel_height()

    layer.paint({ x: 0 y: 0 width height }, fn (pixels : []u32,
                                                width  : u32,
                                                height : u32,
                                                stride : u32,
                                                user   : ^void) {
        tick := (user.as(^u32))^
        for y in [0 .. height] {
            for x in [0 .. width] {
                index := y * stride + x
                cx    := width / 2
                cy    := height / 2
                dx    := on x > cx => x - cx else cx - x
                dy    := on y > cy => y - cy else cy - y

                -- Squared distance tests a circular mask without a square root. Skipped
                -- pixels retain transparent colour and therefore reveal the lower layer.
                on dx * dx + dy * dy > 32 * 32 => again
                pixels[index] = foreground_colour(x, y, tick)
            }
        }
    }, user = ^tick)

    layer.fill(PixelRect { x: 0 y: 0 width height: 2 }, 0xffffffff)
    layer.fill(PixelRect { x: 0 y: height - 2 width height: 2 }, 0xffffffff)
    layer.fill(PixelRect { x: 0 y: 0 width: 2 height }, 0xffffffff)
    layer.fill(PixelRect { x: width - 2 y: 0 width: 2 height }, 0xffffffff)

    bar_width := (tick % width) + 1
    layer.fill(PixelRect { x: 4 y: height - 8 width: bar_width height: 4 },
               0xffffcc40)
}

-- Handles resolve to graphics-owned layers. Updating both before render
-- presents their combined contents as one frame.
render_layers :: fn (gfx        : ^GfxSystem,
                     background : GfxLayerHandle,
                     foreground : GfxLayerHandle,
                     frame      : ^Frame,
                     tick       : u32) -> bool\GfxError {
    background_layer := (gfx.get_pixel_layer(background))?
    foreground_layer := (gfx.get_pixel_layer(foreground))?

    draw_background(background_layer, tick)
    draw_foreground(foreground_layer, tick)
    gfx.render(frame)
    return yes
}

-- Keep the frame system alive for the whole graphics lifetime. Deferred cleanup
-- runs in reverse order, releasing graphics before the native window system.
main :: fn () {
    frame_system := FrameSystem.init()
    frame := Frame {
        id          : NEW_FRAME
        width       : 768
        height      : 512
        title       : "Pixel Layers"
        full_screen : no
        resizable   : yes
        ...
    }

    -- Create the native window from its Frame description before attaching layers.
    frame_system.apply(^frame)
    defer frame_system.done()

    gfx := GfxSystem.init()
    defer gfx.done()

    -- Create the opaque background first, then the foreground that overlays it.
    -- Each mode controls its own logical size independently of the other layer.
    background := gfx.create_pixel_layer(^frame,
                                         PixelLayerMode.FitToWindow { pixel_scale: 4 })
    foreground := gfx.create_pixel_layer(^frame,
                                         PixelLayerMode.FixedSizeAutoScale {
        width  : 96
        height : 72
    })

    tick : u32 = 0

    -- Refresh window state and drain queued input events before drawing. This
    -- keeps resize and close requests responsive as the animation advances.
    for frame_system.loop() {
        frame_system.update(^frame)

        for event := frame_system.poll(^frame);
            event != FrameEvent.None;
            event = frame_system.poll(^frame) {
            on event {
                None => {
                }

                Closed => {
                }

                KeyPress { scan_code } => {
                    on scan_code {
                        Escape => {
                            frame_system.close(^frame)
                        }

                        Q => {
                            frame_system.close(^frame)
                        }

                        Enter => {
                            on frame_system.is_alt_down() => {
                                frame.full_screen = !frame.full_screen
                                frame_system.apply(^frame)
                            }
                        }
                    }
                }
            }
        }

        _ := render_layers(^gfx, background, foreground, ^frame, tick)

        -- Advance a simple animation counter and pause briefly to avoid a tight busy
        -- loop. This is basic pacing rather than synchronisation with display refresh.
        tick += 1
        sleep_ms(16)
    }

    frame_system.close(^frame)
}
