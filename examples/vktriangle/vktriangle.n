-- Vulkan setup walkthrough: create an instance and window surface, choose a
-- discrete GPU and find a queue family that supports graphics and presentation.
-- Despite the example name, this currently stops at setup: it does not create a
-- logical device, swapchain or graphics pipeline, and does not render a
-- triangle. It illustrates explicit resource construction and rollback when
-- setup fails.

use std.frame
use std.slice
use std.vulkan

-- The frame system owns the window; the returned Vulkan context owns instance
-- and surface resources. Reverse-order defers keep those dependencies alive.
main :: fn () -> ?void {
    frame_system := FrameSystem.init()
    defer frame_system.done()

    main_window := {
        system      : ^frame_system
        id          : NEW_FRAME
        width       : 800
        height      : 600
        title       : "Vulkan Triangle"
        full_screen : no
        resizable   : yes
    }

    frame_system.apply(^main_window)

    -- Optional returns signal setup failure with nil; ? propagates that failure
    -- after cleanup. Successful setup keeps its resources until vk_done.
    vk_context := vk_init(^main_window)?
    defer vk_done(^vk_context)

    -- This loop handles window events only. Rendering and swapchain resize
    -- handling would be additional stages beyond the setup shown here.
    for frame_system.loop() {
        frame_system.update(^main_window)
        on frame_system.poll(^main_window) {
            None => {
            }

            Resized { width: _, height: _ } => {
            }

            KeyPress { scan_code: Q },
            KeyPress { scan_code: Escape } => {
                -- Deferred cleanup releases Vulkan before the native window.
                frame_system.close(^main_window)
            }
        }
    }
}

-- Group handles by ownership: instance and surface need destruction; the
-- physical device and queue-family index identify capabilities borrowed from
-- Vulkan.
VulkanContext :: plex {
    frame              ^Frame
    instance           VkInstance
    surface            VkSurfaceKHR
    physical_device    VkPhysicalDevice
    queue_family_index u32
}

-- Build resources in dependency order. Register undo after each successful
-- step: later failure runs rollback in reverse order, while success retains the
-- resources for the caller to release with vk_done.
vk_init :: fn (frame: ^Frame) -> ?VulkanContext {
    -- Begin with empty handles; each successful step fills its owned state.
    ctx : VulkanContext = { frame ... }

    create_vk_instance(^ctx)?
    undo destroy_vk_instance(^ctx)
    create_vk_surface(^ctx)?
    undo destroy_vk_surface(^ctx)
    create_vk_physical_device(^ctx)?
    undo destroy_vk_physical_device(^ctx)
    create_vk_queue(^ctx)?
    undo destroy_vk_queue(^ctx)

    return ctx
}

-- Tear down dependants before their owners. Queue-family and physical-device
-- selection have no separately owned object to destroy in this example.
vk_done :: fn (ctx: ^VulkanContext) {
    destroy_vk_queue(ctx)
    destroy_vk_physical_device(ctx)
    destroy_vk_surface(ctx)
    destroy_vk_instance(ctx)
}

-- Vulkan calls this C-compatible callback with borrowed diagnostic data. Report
-- warnings/errors and return VK_FALSE to let Vulkan continue the call.
debug_callback :: fn (messageSeverity : VkDebugUtilsMessageSeverityFlagBitsEXT,
                      _messageType    : VkDebugUtilsMessageTypeFlagsEXT,
                      callbackData    : ^VkDebugUtilsMessengerCallbackDataEXT,
                      _userData       : ^void) -> VkBool32 {
    on messageSeverity >= VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT => {
        prn($"Vulkan Debug: {callbackData.pMessage}")
    }
    return VK_FALSE
}

-- The instance is the entry point for Vulkan discovery. Enable the window
-- surface extensions and validation layer requested by this development
-- example.
create_vk_instance :: fn (ctx: ^VulkanContext) -> ?void {
    assert ctx != nil, "Vulkan context must not be nil"

    extensions := vk_get_extensions(debug = yes)
    layers := [
        VK_LAYER_KHRONOS_VALIDATION_LAYER_NAME,
    ]

    result := vkCreateInstance(^{
        sType: VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
        -- pNext chains an additional configuration record onto the instance request.
        -- This registers diagnostics for instance creation and destruction.
        pNext: ^VkDebugUtilsMessengerCreateInfoEXT {
            sType           : VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT
            messageSeverity : VK_DEBUG_UTILS_MESSAGE_SEVERITY_VERBOSE_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT
            messageType     : VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT | VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT
            pfnUserCallback : debug_callback
            ...
        }
        pApplicationInfo: ^{
            sType            : VK_STRUCTURE_TYPE_APPLICATION_INFO
            pApplicationName : c"Vulkan Example"
            apiVersion       : VK_API_VERSION_1_4
            ...
        }
        ppEnabledExtensionNames : extensions.data
        enabledExtensionCount   : extensions.count.as(u32)
        ppEnabledLayerNames     : layers.data
        enabledLayerCount       : layers.count.as(u32)
        ...
    }, nil, ^ctx.instance)

    on result {
        VK_SUCCESS => {
            prn("Vulkan instance created successfully")
        }

        else => {
            prn($"Failed to create Vulkan instance: {result}")
            prn($"Error: {vk_result_to_string(result)}")
            ctx.instance = nil
            return nil
        }
    }
}

-- Destroy only an existing instance and clear its handle afterwards.
destroy_vk_instance :: fn (ctx: ^VulkanContext) {
    on ctx.instance != nil => {
        vkDestroyInstance(ctx.instance, nil)
        ctx.instance = nil
    }
}

-- A surface connects Vulkan to the platform window; it is not an image buffer
-- and does not itself present rendered pixels.
create_vk_surface :: fn (ctx: ^VulkanContext) -> ?void {
    assert ctx != nil, "Vulkan context must not be nil"

    result := vk_create_surface(ctx.instance, ctx.frame, ^ctx.surface)
    on result != VK_SUCCESS => {
        prn($"Failed to create Vulkan surface: {result}")
        prn($"Error: {vk_result_to_string(result)}")
        ctx.surface = nil
        return nil
    }
}

-- Release the surface before its parent instance is destroyed.
destroy_vk_surface :: fn (ctx: ^VulkanContext) {
    on ctx.surface != nil => {
        vkDestroySurfaceKHR(ctx.instance, ctx.surface, nil)
        ctx.surface = nil
    }
}

-- Use Vulkan's two-call enumeration pattern: first obtain a count, then provide
-- storage for the returned handles. This example requires a discrete GPU.
create_vk_physical_device :: fn (ctx: ^VulkanContext) -> ?void {
    assert ctx != nil, "Vulkan context must not be nil"

    -- Physical devices are borrowed from the instance; no separate cleanup.
    num_devices : u32
    result            := vkEnumeratePhysicalDevices(ctx.instance, ^num_devices, nil)

    on {
        result != VK_SUCCESS => {
            prn($"Failed to enumerate Vulkan physical devices: {vk_result_to_string(result)}")
            return nil
        }
        num_devices == 0 => {
            prn("No Vulkan physical devices found")
            return nil
        }
    }

    devices : [num_devices]VkPhysicalDevice
    result = vkEnumeratePhysicalDevices(ctx.instance,
                                        ^num_devices,
                                        devices.data)

    -- Search the returned devices, including a partial enumeration.
    on {
        result != VK_SUCCESS && result != VK_INCOMPLETE => {
            prn($"Failed to enumerate Vulkan physical devices: {vk_result_to_string(result)}")
            return nil
        }
        num_devices == 0 => {
            prn("No Vulkan physical devices found")
            return nil
        }
    }

    for device in devices {
        prn($"Found Vulkan physical device: {device^}")
    }

    for device in devices {
        properties : VkPhysicalDeviceProperties
        vkGetPhysicalDeviceProperties(device^, ^properties)
        on properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU => {
            ctx.physical_device = device^
            prn($"Selected Vulkan physical device: {device^}")
            return
        }
    }

    prn("No discrete Vulkan GPU found")
    return nil
}

-- Forget the selected borrowed handle; the instance controls its lifetime.
destroy_vk_physical_device :: fn (ctx: ^VulkanContext) {
    -- Physical devices are borrowed from the instance; no separate cleanup.
    ctx.physical_device = nil
}

-- Discover a queue family, not an actual queue. A family describes supported
-- work; a logical device would later create queues from the chosen family.
create_vk_queue :: fn (ctx: ^VulkanContext) -> ?void {
    assert ctx != nil, "Vulkan context must not be nil"

    queue_family_count : u32
    vkGetPhysicalDeviceQueueFamilyProperties2(ctx.physical_device,
                                              ^queue_family_count,
                                              nil)

    queue_families : [queue_family_count]VkQueueFamilyProperties2
    -- Initialise the required sType tag on each output record before enumeration.
    queue_families.fill(^{
        sType: VK_STRUCTURE_TYPE_QUEUE_FAMILY_PROPERTIES_2
        ...
    })
    vkGetPhysicalDeviceQueueFamilyProperties2(ctx.physical_device,
                                              ^queue_family_count,
                                              queue_families.data)

    for i, queue_family in queue_families {
        has_present_support : VkBool32
        _ := vkGetPhysicalDeviceSurfaceSupportKHR(ctx.physical_device,
                                                  i.as(u32),
                                                  ctx.surface,
                                                  ^has_present_support)

        -- Require both graphics commands and presentation to this window surface.
        -- The stored index would be used in later logical-device setup.
        on ((queue_family.queueFamilyProperties.queueFlags & VK_QUEUE_GRAPHICS_BIT) != 0) &&
            (has_present_support != 0) => {
            prn($"Found Vulkan queue family: {queue_family^} at index {i}")
            ctx.queue_family_index = i.as(u32)
            return
        }
    }
}

-- No queue or logical device has been created, so this placeholder owns nothing
-- to release yet.
destroy_vk_queue :: fn (_ctx: ^VulkanContext) {
}
