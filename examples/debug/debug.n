-- Debugger inspection example: construct a selection of Nerd values and keep
-- them live together at a checkpoint. Set a breakpoint in debugger_values to
-- inspect records, pointers, unions, enum payloads, tuples, arrays and slices.
-- The final calculation ensures the values contribute to observable behaviour;
-- this is a debugging exercise rather than an application algorithm.

-- A plex groups named fields in one value; a pointer lets the debugger also
-- show a reference to that value and the fields reached through it.
DebugPoint :: plex {
    x i32
    y i32
}

DebugCell :: plex {
    ch    u32
    ink   u32
    paper u32
    flags u32
}

-- A union shares storage between its alternatives and has no active-case tag.
-- Here the i field is written and read; the f interpretation is only for
-- inspection.
DebugRaw :: union {
    i i32
    f f32
}

-- An enum records which case is active. Payload cases carry values that an on
-- branch can bind only when that case matches.
DebugEvent :: enum {
    None
    Move(DebugPoint)
    Message(string)
    Count(i32)
}

-- Module-level values exercise global inspection alongside local variables. The
-- dynamic array owns storage and must be freed before the program ends.
global_counter : i32
global_cells   : [..]DebugCell
global_event   : DebugEvent

-- Give globals recognisable contents before entering the local-value exercise.
debugger_seed_globals :: fn () {
    global_counter = 41
    global_cells.push(DebugCell { ch: 'G' ink: 1 paper: 2 flags: 3 })
    global_cells.push(DebugCell { ch: 'H' ink: 4 paper: 5 flags: 6 })
    global_event = DebugEvent.Count(global_cells.count.as(i32))
}

-- Pattern matching selects the active enum case and exposes its payload. Every
-- case produces a number so each branch can be checked in the debugger.
debugger_branch_value :: fn (event: DebugEvent) -> i32 {
    result := 0

    on event {
        DebugEvent.None => {
            result = 1
        }

        DebugEvent.Move(point) => {
            result = point.x + point.y
        }

        DebugEvent.Message(text) => {
            result = text.count.as(i32)
        }

        DebugEvent.Count(value) => {
            result = value
        }
    }

    return result
}

-- Create varied locals, then inspect them before the cleanup at the end.
debugger_values :: fn (scale: i32) -> i32 {
    label                    := "debugger"
    point                    := DebugPoint { x: 3 y: 4 }
    point_ptr                := ^point
    raw_value     : DebugRaw = DebugRaw { i: 12 }
    fixed_numbers            := [10, 20, 30]
    pair                     := ("east", 7)

    -- Dynamic arrays own growable storage. A slice is a borrowed view of that
    -- storage, so these views are created after the pushes and used before free.
    bytes : [..]u8
    bytes.push('A')
    bytes.push('B')
    bytes.push('C')
    byte_slice := bytes[..]

    numbers : [..]i32
    numbers.push(100)
    numbers.push(200)
    numbers.push(300)
    number_slice := numbers[..]
    tail_slice   := numbers[1..]

    cells : [..]DebugCell
    cells.push(DebugCell { ch: 'a' ink: 10 paper: 20 flags: 1 })
    cells.push(DebugCell { ch: 'b' ink: 11 paper: 21 flags: 2 })
    cells.push(DebugCell { ch: 'c' ink: 12 paper: 22 flags: 3 })

    -- Keep one value of each enum case live to compare empty and payload cases.
    none_event           : DebugEvent = DebugEvent.None
    local_event                       := DebugEvent.Move(point)
    message_event                     := DebugEvent.Message(label)
    count_event                       := DebugEvent.Count(numbers.count.as(i32))
    none_branch_value                 := debugger_branch_value(none_event)
    branch_value                      := debugger_branch_value(local_event)
    message_branch_value              := debugger_branch_value(message_event)
    count_branch_value                := debugger_branch_value(count_event)
    global_branch_value               := debugger_branch_value(global_event)

    -- This line is a useful breakpoint: all the data above is still live.
    -- The expression reads through both aggregate values and borrowed pointers.
    checkpoint := label.count.as(i32) + point_ptr.x + raw_value.i + fixed_numbers[1] + pair.1.as(i32) + byte_slice.data[1].as(i32) + number_slice.data[0] + tail_slice.data[0] + cells[1].flags.as(i32) + none_branch_value + branch_value + message_branch_value + count_branch_value + global_branch_value + scale

    on checkpoint > 0 => prn($"debug checkpoint {checkpoint}")

    -- Release owners after the last use of their slices; freeing an owner would
    -- invalidate any debugger view or program reference to its storage.
    cells.free()
    numbers.free()
    bytes.free()

    return checkpoint
}

-- Seed globals, run the checkpoint and release the remaining global owner.
main :: fn () {
    debugger_seed_globals()

    total := debugger_values(2)
    assert total > global_counter

    global_cells.free()
}
