use std.io
use std.raptor

print_number :: fn (number: ^i32) {
    prn($"Main thread: {number^}")
}

main :: fn () -> ?void {
    scheduler : Scheduler
    scheduler.init(4)?
    defer assert scheduler.close()
    values                 := [10, 20, 30]
    tasks  : [3]Task[void]
    queue                  := scheduler.get_main_queue()

    -- This example's callbacks submit no further work: one batch also covers
    -- accepted tasks if a later submission propagates failure.
    defer assert scheduler.run_main_tasks() != nil
    for i in [0 .. values.count] {
        tasks[i].create(print_number, ^values[i])
        queue.async(^tasks[i])?
    }
    on scheduler.run_main_tasks() {
        count => {
            assert count == 3
        }

        else => {
            assert no
        }
    }
    assert when_all(tasks[..])
    return
}
