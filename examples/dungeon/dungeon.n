-- Procedural dungeon in a terminal: place separated rooms, fill unused space
-- with mazes, connect regions with doors and prune dead ends. Generation works
-- on a cell grid; presentation turns its tiles into terminal glyphs and
-- colours. Any key regenerates with a new seed, while Q/Escape quits. Resizing
-- also rebuilds the map. Simulation and presentation are callbacks driven by
-- std.term.

use std.random
use std.term
use std.time

-- Tile is the visible terrain category. Cells also retain a generation-region
-- identifier so initially disconnected areas can be joined deliberately.
Tile :: enum {
    Wall
    Floor
    Door
}

Cell :: plex {
    tile   Tile
    region i32
}

-- Rooms are rectangles placed on the odd-coordinate grid with a wall margin.
Room :: plex {
    x i32
    y i32
    w i32
    h i32
}

Pos :: plex {
    x i32
    y i32
}

-- A connector is a wall cell between two region identifiers. Opening it as a
-- door can merge those regions into one connected component.
Connector :: plex {
    x i32
    y i32
    a i32
    b i32
}

-- The flat cell array uses row-major indexing. These growable arrays own
-- storage, clear for regeneration and free after the terminal loop stops.
cells      : [..]Cell
rooms      : [..]Room
connectors : [..]Connector
map_width  : u32
map_height : u32
seed       : u64
generated  : bool

stone_void  :: rgb(8, 10, 14)
wall_ink    :: rgb(45, 42, 46)
wall_paper  :: rgb(190, 180, 184)
floor_dark  :: rgb(42, 34, 26)
floor_mid   :: rgb(70, 54, 38)
floor_light :: rgb(112, 86, 54)
door_ink    :: rgb(232, 126, 102)
door_paper  :: rgb(88, 22, 18)
text_ink    :: rgb(224, 212, 176)

-- Map a valid (x, y) cell coordinate to its position in the flat array.
dungeon_index :: fn (x: i32, y: i32) => (y.as(u32) * map_width + x.as(u32)).as(usize)

-- Reject coordinates outside the allocated map before any array access.
dungeon_in_bounds :: fn (x: i32, y: i32) -> bool {
    return x >= 0 && y >= 0 && x < map_width.as(i32) && y < map_height.as(i32)
}

-- Keep generation away from the outermost ring so the map has a wall boundary.
dungeon_inner :: fn (x: i32, y: i32) -> bool {
    return x > 0 && y > 0 && x < map_width.as(i32) - 1 && y < map_height.as(i32) - 1
}

-- Treat out-of-map neighbours as walls, simplifying edge checks in algorithms.
dungeon_cell :: fn (x: i32, y: i32) -> Cell {
    on !dungeon_in_bounds(x, y) => return Cell { tile: Tile.Wall region: -1 }
    return cells[dungeon_index(x, y)]
}

-- Update both terrain and its region label when carving or closing a cell.
dungeon_set :: fn (x: i32, y: i32, tile: Tile, region: i32) {
    on !dungeon_in_bounds(x, y) => return
    cells[dungeon_index(x, y)] = Cell { tile region }
}

-- Floors and doors both participate in connectivity; walls do not.
dungeon_passable :: fn (x: i32, y: i32) -> bool {
    cell := dungeon_cell(x, y)
    return cell.tile == Tile.Floor || cell.tile == Tile.Door
}

-- Only show wall detail beside passable cells, leaving solid unused areas dark.
dungeon_wall_visible :: fn (x: i32, y: i32) -> bool {
    for dy: i32 = -1; dy <= 1; dy += 1 {
        for dx: i32 = -1; dx <= 1; dx += 1 {
            on dx == 0 && dy == 0 => again
            on dungeon_passable(x + dx, y + dy) => return yes
        }
    }

    return no
}

-- Adapt the random API to the signed coordinates used by the generator.
rand_i32 :: fn (min: i32, max: i32) => random_range_i64(min.as(i64), max.as(i64)).as(i32)

-- Odd coordinates and dimensions leave space between maze cells for walls.
-- Two-cell carving steps can later open the intervening wall as a corridor.
rand_odd :: fn (min: i32, max: i32) -> i32 {
    value := rand_i32(min, max)
    on value % 2 == 0 => value += 1
    on value > max => value -= 2
    return value
}

-- Reject rooms that overlap existing rooms or their one-cell separation margin.
dungeon_room_overlaps :: fn (room: Room) -> bool {
    for existing in rooms {
        on room.x < existing.x + existing.w + 1 &&
            room.x + room.w + 1 > existing.x &&
            room.y < existing.y + existing.h + 1 &&
            room.y + room.h + 1 > existing.y => return yes
    }
    return no
}

-- Carve a room rectangle and give all its cells one shared region identifier.
dungeon_add_room :: fn (room: Room, region: i32) {
    rooms.push(room)

    for y: i32 = room.y; y < room.y + room.h; y += 1 {
        for x: i32 = room.x; x < room.x + room.w; x += 1 {
            dungeon_set(x, y, Tile.Floor, region)
        }
    }
}

-- Try a bounded number of random room placements. Rejected candidates simply
-- leave more space for the maze stage instead of forcing a room into the map.
dungeon_add_rooms :: fn (region: ^i32) {
    attempts := (map_width * map_height / 18).as(i32)
    on attempts < 40 => attempts = 40
    on attempts > 180 => attempts = 180

    for attempt: i32 = 0; attempt < attempts; attempt += 1 {
        max_w := map_width.as(i32) / 5
        max_h := map_height.as(i32) / 4

        on max_w < 5 => max_w = 5
        on max_h < 5 => max_h = 5
        on max_w > 13 => max_w = 13
        on max_h > 9 => max_h = 9

        w := rand_odd(3, max_w)
        h := rand_odd(3, max_h)

        on map_width.as(i32) - w - 2 <= 1 ||
            map_height.as(i32) - h - 2 <= 1 => again

        x    := rand_odd(1, map_width.as(i32) - w - 2)
        y    := rand_odd(1, map_height.as(i32) - h - 2)
        room := Room { x y w h }

        on !dungeon_room_overlaps(room) => {
            dungeon_add_room(room, region^)
            region^ += 1
        }
    }
}

-- Encode the four cardinal directions as offsets used by carving and
-- neighbours.
dungeon_direction_dx :: fn (direction: i32) -> i32 {
    return on direction {
        0     => 0
        1     => 1
        2     => 0
        else  => -1
    }
}

-- Provide the vertical half of the same direction-to-offset mapping.
dungeon_direction_dy :: fn (direction: i32) -> i32 {
    return on direction {
        0     => -1
        1     => 0
        2     => 1
        else  => 0
    }
}

-- A maze step moves two cells: the target must still be an interior wall cell.
-- This preserves a separating wall between neighbouring maze paths.
dungeon_can_carve :: fn (x: i32, y: i32, direction: i32) -> bool {
    dx       := dungeon_direction_dx(direction)
    dy       := dungeon_direction_dy(direction)
    target_x := x + dx * 2
    target_y := y + dy * 2

    return dungeon_inner(target_x, target_y) && dungeon_cell(target_x, target_y).tile == Tile.Wall
}

-- Use a stack for depth-first search instead of recursive function calls.
-- Choose an uncarved neighbour, open the intermediate wall and advance; when no
-- choices remain, pop the stack to backtrack.
dungeon_carve_maze :: fn (start_x: i32, start_y: i32, region: i32) {
    stack : [..]Pos
    stack.push(Pos { x: start_x y: start_y })
    dungeon_set(start_x, start_y, Tile.Floor, region)

    for stack.count > 0 {
        current := stack[stack.count - 1]
        -- Candidate storage is temporary for this step and is freed on both the
        -- backtracking path and the successful-carve path.
        candidates : [..]i32

        for direction: i32 = 0; direction < 4; direction += 1 {
            on dungeon_can_carve(current.x, current.y, direction) => candidates.push(direction)
        }

        on candidates.count == 0 => {
            _ := stack.pop()
            candidates.free()
            again
        }

        direction := candidates[random_range_u64(0, candidates.count.as(u64) - 1).as(usize)]
        candidates.free()

        dx := dungeon_direction_dx(direction)
        dy := dungeon_direction_dy(direction)

        dungeon_set(current.x + dx, current.y + dy, Tile.Floor, region)
        dungeon_set(current.x + dx * 2, current.y + dy * 2, Tile.Floor, region)
        stack.push(Pos { x: current.x + dx * 2 y: current.y + dy * 2 })
    }

    stack.free()
}

-- Start a separate maze region at each remaining uncarved odd-grid cell. The
-- later connector stage is responsible for joining these regions to rooms.
dungeon_add_mazes :: fn (region: ^i32) {
    for y: i32 = 1; y < map_height.as(i32); y += 2 {
        for x: i32 = 1; x < map_width.as(i32); x += 2 {
            on dungeon_cell(x, y).tile == Tile.Wall => {
                dungeon_carve_maze(x, y, region^)
                region^ += 1
            }
        }
    }
}

-- Look for a wall with neighbouring cells from at least two distinct regions.
-- Each candidate records which regions a door at that position could connect.
dungeon_find_connectors :: fn () {
    connectors.clear()

    for y: i32 = 1; y < map_height.as(i32) - 1; y += 1 {
        for x: i32 = 1; x < map_width.as(i32) - 1; x += 1 {
            on dungeon_cell(x, y).tile != Tile.Wall => again

            a : i32 = -1
            b : i32 = -1

            for direction: i32 = 0; direction < 4; direction += 1 {
                dx     := dungeon_direction_dx(direction)
                dy     := dungeon_direction_dy(direction)
                region := dungeon_cell(x + dx, y + dy).region

                on region < 0 => again
                on a < 0 => {
                    a = region
                } else {
                    on region != a && b < 0 => b = region
                }
            }

            on a >= 0 && b >= 0 => connectors.push(Connector { x y a b })
        }
    }
}

-- Follow parent links to the representative of a disjoint set. These sets track
-- which original regions have already been joined by doors.
region_find :: fn (parents: [..]i32, value: i32) -> i32 {
    current := value
    for parents[current.as(usize)] != current {
        current = parents[current.as(usize)]
    }
    return current
}

-- Merge two disjoint sets by linking one representative to the other. Cell
-- region labels stay unchanged; the parent table records merged connectivity.
region_union :: fn (parents: [..]i32, a: i32, b: i32) {
    root_a := region_find(parents, a)
    root_b := region_find(parents, b)

    on root_a != root_b => parents[root_b.as(usize)] = root_a
}

-- Use absolute coordinate differences when comparing connector spacing.
dungeon_abs_i32 :: fn (value: i32) -> i32 {
    on value < 0 => return -value
    return value
}

-- Discard nearby candidates after placing a door to avoid adjacent doors.
-- swap_delete fills the removed slot with another candidate, so recheck its
-- index.
dungeon_remove_nearby_connectors :: fn (connector: Connector) {
    i : usize = 0
    for i < connectors.count {
        other := connectors[i]
        dx    := dungeon_abs_i32(other.x - connector.x)
        dy    := dungeon_abs_i32(other.y - connector.y)

        on dx <= 1 &&
            dy <= 1 => {
            connectors.swap_delete(i)
            again
        }

        i += 1
    }
}

-- Start with each region separate and choose candidate doors randomly. Open
-- doors between different sets; occasionally keep an extra same-set connector
-- to introduce a loop instead of making every route tree-shaped.
dungeon_connect_regions :: fn (region_count: i32) {
    dungeon_find_connectors()

    parents : [..]i32
    parents.resize_to(region_count.as(usize))
    for i: i32 = 0; i < region_count; i += 1 {
        parents[i.as(usize)] = i
    }

    for connectors.count > 0 {
        index     := random_range_u64(0, connectors.count.as(u64) - 1).as(usize)
        connector := connectors[index]

        connectors.swap_delete(index)

        root_a     := region_find(parents, connector.a)
        root_b     := region_find(parents, connector.b)
        extra_loop := random_range_u64(0, 18) == 0

        on root_a != root_b ||
            extra_loop => {
            dungeon_set(connector.x, connector.y, Tile.Door, connector.a)
            region_union(parents, root_a, root_b)
            dungeon_remove_nearby_connectors(connector)
        }
    }

    parents.free()
}

-- Repeatedly replace passable cells with at most one exit by walls. Removing
-- one dead end can expose another, so continue until a pass changes nothing.
dungeon_remove_dead_ends :: fn () {
    changed := yes

    for changed {
        changed = no

        for y: i32 = 1; y < map_height.as(i32) - 1; y += 1 {
            for x: i32 = 1; x < map_width.as(i32) - 1; x += 1 {
                on !dungeon_passable(x, y) => again

                exits := 0
                for direction: i32 = 0; direction < 4; direction += 1 {
                    dx := dungeon_direction_dx(direction)
                    dy := dungeon_direction_dy(direction)

                    on dungeon_passable(x + dx, y + dy) => exits += 1
                }

                on exits <= 1 => {
                    dungeon_set(x, y, Tile.Wall, -1)
                    changed = yes
                }
            }
        }
    }
}

-- Choose an odd map width to preserve the maze grid and boundary walls.
dungeon_generation_width :: fn (terminal_width: u32) -> u32 {
    width := terminal_width
    on width % 2 == 0 => width -= 1
    return width
}

-- Reserve terminal rows for status text, then choose an odd map height.
dungeon_generation_height :: fn (terminal_height: u32) -> u32 {
    height := terminal_height
    on height > 3 => height -= 2
    on height % 2 == 0 => height -= 1
    return height
}

-- Reinitialise the reusable buffers to walls and run the generation phases in
-- order: rooms, mazes, doors, then dead-end pruning.
dungeon_generate :: fn (terminal_width: u32, terminal_height: u32) {
    map_width  = dungeon_generation_width(terminal_width)
    map_height = dungeon_generation_height(terminal_height)

    cells.clear()
    rooms.clear()
    connectors.clear()
    cells.resize_to((map_width * map_height).as(usize))

    for i: usize = 0; i < cells.count; i += 1 {
        cells[i] = Cell { tile: Tile.Wall region: -1 }
    }

    region : i32 = 0
    dungeon_add_rooms(^region)
    dungeon_add_mazes(^region)
    dungeon_connect_regions(region)
    dungeon_remove_dead_ends()
    generated = yes
}

-- Derive stable visual noise from position and seed. Drawing uses this hash
-- instead of consuming random numbers and changing the generation sequence.
dungeon_hash :: fn (x: u32, y: u32) -> u32 {
    value := x.as(u64) * 1103515245 + y.as(u64) * 12345 + seed

    value ~= value >> 11
    value ~= value << 7
    return (value & 0xffff).as(u32)
}

-- Brighten RGB channels with saturation so texture variation cannot wrap a
-- channel past 255 and unexpectedly make it dark.
dungeon_colour_step :: fn (base: Colour, amount: u32) -> Colour {
    r := ((base >> 16) & 0xff) + amount
    g := ((base >> 8) & 0xff) + amount
    b := (base & 0xff) + amount

    on r > 255 => r = 255
    on g > 255 => g = 255
    on b > 255 => b = 255
    return rgb(r.as(u8), g.as(u8), b.as(u8))
}

-- Translate terrain to glyphs and colours, with position-based texture
-- variation.
dungeon_draw_cell :: fn (x: u32, y: u32) {
    cell  := dungeon_cell(x.as(i32), y.as(i32))
    noise := dungeon_hash(x, y) % 28

    on cell.tile {
        Tile.Wall => {
            on dungeon_wall_visible(x.as(i32), y.as(i32)) => {
                paper := dungeon_colour_step(wall_paper, noise / 2)
                ink   := dungeon_colour_step(wall_ink, noise / 4)

                term_fb_put(x.as(i32), y.as(i32), '#', ink = ink, paper = paper)
            } else {
                term_fb_put(x.as(i32),
                            y.as(i32),
                            ' ',
                            ink = stone_void,
                            paper = rgb(0, 0, 0))
            }
        }

        Tile.Floor => {
            paper := dungeon_colour_step(floor_dark, noise / 3)
            ink   := dungeon_colour_step(floor_mid, noise)

            term_fb_put(x.as(i32), y.as(i32), '.', ink = ink, paper = paper)
        }

        Tile.Door => {
            term_fb_put(x.as(i32),
                        y.as(i32),
                        '+',
                        ink = door_ink,
                        paper = door_paper)
        }
    }
}

-- Regenerate only when needed, then draw the map and its status rows. A
-- terminal resize changes the usable generation dimensions.
dungeon_draw :: fn (width: u32, height: u32) {
    on !generated ||
        map_width != dungeon_generation_width(width) ||
        map_height != dungeon_generation_height(height) => dungeon_generate(width, height)

    term_fb_clear()
    term_fb_fill_rect(0,
                      0,
                      width,
                      height,
                      ch = ' ',
                      ink = text_ink,
                      paper = rgb(0, 0, 0))

    offset_x := ((width - map_width) / 2).as(i32)
    for y: u32 = 0; y < map_height; y += 1 {
        for x: u32 = 0; x < map_width; x += 1 {
            dungeon_draw_cell(x, y)
        }
    }

    status_y := map_height.as(i32)
    term_fb_fill_rect(0,
                      status_y,
                      width,
                      height - map_height,
                      ch = ' ',
                      ink = text_ink,
                      paper = rgb(0, 0, 0))
    term_fb_text(1,
                 status_y,
                 $"rooms {rooms.count}  seed {seed}  size {map_width}x{map_height}",
                 ink = text_ink,
                 paper = rgb(0, 0, 0))
    term_fb_text(1,
                 status_y + 1,
                 "any key regenerates   q/Esc exit",
                 ink = rgb(150, 185, 150),
                 paper = rgb(0, 0, 0))

    on offset_x != 0 => {
    }
}

-- Handle exit keys first. Any other pressed key chooses a fresh seed and
-- invalidates the map so presentation will regenerate it on the next draw.
dungeon_simulate :: fn (sim: TermSimulate) {
    on sim.key_pressed(Q) ||
        sim.key_pressed(Escape) => {
        term_done()
        return
    }

    for i: usize = 0; i < TERM_SCAN_CODE_COUNT.as(usize); i += 1 {
        on sim.keyboard.pressed[i] => {
            seed = now()
            random_seed(seed)
            generated = no
            return
        }
    }
}

-- Draw using the current terminal dimensions supplied by the presentation hook.
dungeon_present :: fn (present: TermPresent) {
    dungeon_draw(present.width, present.height)
}

-- The checks below use a fixed seed for reproducible generation. Each frees the
-- shared arrays afterwards so one test does not retain another's map storage.
test "dungeon generation creates expected width" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(41, 19)

    valid := map_width == 41

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert valid
}

test "dungeon generation creates expected height" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(41, 19)

    valid := map_height == 17

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert valid
}

test "dungeon generation creates matching cell count" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(41, 19)

    valid := cells.count == (map_width * map_height).as(usize)

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert valid
}

test "dungeon generation creates regioned passable cells" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(41, 19)

    valid := yes
    for y: u32 = 0; y < map_height; y += 1 {
        for x: u32 = 0; x < map_width; x += 1 {
            cell := dungeon_cell(x.as(i32), y.as(i32))
            on cell.tile == Tile.Floor ||
                cell.tile == Tile.Door => {
                on cell.region < 0 => valid = no
            }
        }
    }

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert valid
}

test "dungeon generation avoids adjacent doors" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(61, 25)

    valid := yes
    for y: u32 = 1; y < map_height - 1; y += 1 {
        for x: u32 = 1; x < map_width - 1; x += 1 {
            on dungeon_cell(x.as(i32), y.as(i32)).tile != Tile.Door => again

            for dy: i32 = -1; dy <= 1; dy += 1 {
                for dx: i32 = -1; dx <= 1; dx += 1 {
                    on dx == 0 && dy == 0 => again
                    on dungeon_cell(x.as(i32) + dx, y.as(i32) + dy).tile == Tile.Door => valid = no
                }
            }
        }
    }

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert valid
}

test "dungeon generation exposes walls beside floors" {
    seed = 12345
    random_seed(seed)
    generated = no

    dungeon_generate(41, 19)

    visible_wall_count := 0
    for y: u32 = 1; y < map_height - 1; y += 1 {
        for x: u32 = 1; x < map_width - 1; x += 1 {
            on dungeon_cell(x.as(i32), y.as(i32)).tile == Tile.Wall &&
                dungeon_wall_visible(x.as(i32), y.as(i32)) => visible_wall_count += 1
        }
    }

    cells.free()
    rooms.free()
    connectors.free()
    generated = no

    assert visible_wall_count > 0
}

-- Set up the seed and terminal, install input/draw callbacks and enter the
-- loop. Restore the cursor and free map storage once callbacks have stopped.
main :: fn () {
    seed = now()
    random_seed(seed)
    term_init(min_width = 41, min_height = 19)
    term_cursor_enable(no)
    defer term_cursor_enable(yes)

    -- Handle input at a 16 ms cadence but present at 100 ms. Separating input
    -- from drawing avoids regenerating or repainting continuously in a busy loop.
    term_hook_simulation(from_ms(16), dungeon_simulate)
    term_hook_presentation(from_ms(100), dungeon_present)
    term_run()

    cells.free()
    rooms.free()
    connectors.free()
}
