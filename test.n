Point :: plex {
    x f32
    y f32
}

Rect :: plex {
    use Point
    w f32
    h f32
}

print_point :: fn (p: ^Point) {
    prn($"Point: ({p.x}, {p.y})")
}

print_rect :: fn (r: ^Rect) {
    prn($"Rect: ({r.x}, {r.y}, {r.w}, {r.h})")
}

main :: fn () {
    r := Rect {
        x : 10.0
        y : 20.0
        w : 30.0
        h : 40.0
    }

    print_rect(^r)
}
