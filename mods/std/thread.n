-- Nerd Standard Library (NSL)
--
-- Copyright (c) 2026 Matt Davies
--
-- Explicitly owned joinable threads. Keep each Thread and its borrowed callback
-- context alive at a fixed address until join succeeds. Operations on a Thread
-- are owner-only, not concurrent. See docs/stdlib-thread-sync.md for
-- restrictions.

use os.thread

-- Runtime worker lifecycle: release this thread's temporary storage on exit.
ffi "nrt" {
    -- Initialises the current worker's runtime state.
    nrt_thread_init ()

    -- Releases current-worker TLS without reporting process-wide leaks.
    nrt_thread_done ()
}

-- Runs once on a worker; the caller owns and synchronises the context.
pub ThreadFunction :: fn (context: ^void)

-- A zero-initialised, non-copyable-by-contract joinable thread owner.
pub Thread :: plex {
    handle   usize           -- Native handle, valid only while started.
    function ThreadFunction  -- Callback borrowed until successful join.
    context  ^void           -- Caller-owned callback context; may be nil.
    started  bool            -- Only the owner may access this lifecycle state.
}

on "windows" {

    -- Adapts the callback to the CRT thread entry ABI.
    thread_entry :: fn (context: ^void) -> u32 {
        thread := context.as(^Thread)
        nrt_thread_init()
        thread.function(thread.context)
        nrt_thread_done()
        return 0
    }

}

on "linux" {

    -- Adapts the callback to the pthread entry ABI.
    thread_entry :: fn (context: ^void) -> ^void {
        thread := context.as(^Thread)
        nrt_thread_init()
        thread.function(thread.context)
        nrt_thread_done()
        return nil
    }

}

impl Thread {

    -- Starts a worker; failure leaves an idle object and retains caller ownership.
    -- The callback can run before start returns; it must not access this owner.
    pub start :: fn (self     : ^Thread,
                     function : ThreadFunction,
                     context  : ^void) -> bool {
        on self.started || function.as(^void) == nil => return no
        self.function = function
        self.context = context
        on "windows" {
            self.handle = native_thread_start(nil,
                                  0,
                                  thread_entry.as(^void),
                                  self.as(^void),
                                  0,
                                  nil)
            self.started = self.handle != 0
        }

        on "linux" {
            self.started = native_thread_start(^self.handle, nil, thread_entry.as(^void), self.as(^void)) == 0
        }

        on !self.started => self^ = Thread { ... }
        return self.started
    }

    -- Waits for completion, then releases resources. Idle joins succeed.
    -- Failure retains ownership; joining oneself is rejected rather than deadlocking.
    pub join :: fn (self: ^Thread) -> bool {
        on !self.started => return yes
        on "windows" {
            handle := self.handle.as(^void)
            on native_thread_id(handle) == native_thread_self() => return no
            on native_thread_wait(handle, 0xffffffff) != 0      => return no
            on native_thread_close(handle) == 0                 => return no
        }

        on "linux" {
            on native_thread_equal(self.handle, native_thread_self()) != 0 => return no
            on native_thread_join(self.handle, nil) != 0 => return no
        }

        self^ = Thread { ... }
        return yes
    }

}
