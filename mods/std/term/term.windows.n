on "windows" {

    use os.windows

    term_original_input_mode  : DWORD
    term_original_output_mode : DWORD
    term_original_input_cp    : DWORD
    term_original_output_cp   : DWORD
    term_original_mode_saved  : bool

    -- Applies raw terminal input mode and saves the original Windows console modes.
    term_raw_mode_enable_impl :: fn () {
        on term_original_mode_saved => return

        input  := GetStdHandle(STD_INPUT_HANDLE)
        output := GetStdHandle(STD_OUTPUT_HANDLE)

        input_mode  : DWORD
        output_mode : DWORD

        _ := GetConsoleMode(input, ^input_mode)
        _ := GetConsoleMode(output, ^output_mode)

        term_original_input_mode  = input_mode
        term_original_output_mode = output_mode
        term_original_input_cp    = GetConsoleCP()
        term_original_output_cp   = GetConsoleOutputCP()
        term_original_mode_saved  = yes

        input_mask := (ENABLE_ECHO_INPUT | ENABLE_LINE_INPUT | ENABLE_PROCESSED_INPUT).as(DWORD)

        input_mode  &= ~input_mask
        input_mode  |= (ENABLE_MOUSE_INPUT | ENABLE_WINDOW_INPUT).as(DWORD)
        output_mode |= ENABLE_VIRTUAL_TERMINAL_PROCESSING.as(DWORD)

        _ := SetConsoleCP(CP_UTF8)
        _ := SetConsoleOutputCP(CP_UTF8)
        _ := SetConsoleMode(input, input_mode)
        _ := SetConsoleMode(output, output_mode)
    }

    -- Restores the saved Windows console modes.
    term_raw_mode_disable_impl :: fn () {
        on !term_original_mode_saved => return

        input  := GetStdHandle(STD_INPUT_HANDLE)
        output := GetStdHandle(STD_OUTPUT_HANDLE)

        _ := SetConsoleMode(input, term_original_input_mode)
        _ := SetConsoleMode(output, term_original_output_mode)
        _ := SetConsoleCP(term_original_input_cp)
        _ := SetConsoleOutputCP(term_original_output_cp)

        term_original_mode_saved = no
    }

    -- Enables or disables raw terminal input mode.
    pub term_raw_mode_enable :: fn (enabled: bool) {
        on enabled
            =>   term_raw_mode_enable_impl()
            else term_raw_mode_disable_impl()
    }

    -- Returns the terminal size as `(columns, rows)`, or `(0, 0)` when the terminal
    -- size cannot be read.
    pub term_get_size :: fn () -> (u32, u32) {
        output                              := GetStdHandle(STD_OUTPUT_HANDLE)
        info   : CONSOLE_SCREEN_BUFFER_INFO
        result                              := GetConsoleScreenBufferInfo(output, ^info)

        on result == 0 => return (0, 0)

        columns := term_window_span(info.srWindow.Left, info.srWindow.Right)
        rows    := term_window_span(info.srWindow.Top, info.srWindow.Bottom)

        return term_normalise_size(columns, rows)
    }

    -- Writes text directly to the terminal output stream.
    pub term_print :: fn (text: string) {
        output := GetStdHandle(STD_OUTPUT_HANDLE)

        bytes_written : DWORD
        _ := WriteFile(output,
                       text.data.as(^void),
                       text.count.as(DWORD),
                       ^bytes_written,
                       nil)
    }

    -- Reads one byte from terminal input, returning `0` on EOF or error.
    term_read_byte :: fn () -> u8 {
        input              := GetStdHandle(STD_INPUT_HANDLE)
        key        : [1]u8
        bytes_read : DWORD

        ok := ReadFile(input, key[..].data.as(^void), 1, ^bytes_read, nil)
        on ok == 0 || bytes_read == 0 => return 0
        return key[0]
    }

    -- Reads one byte from terminal input, returning `0` when the timeout elapses.
    term_read_byte_timeout :: fn (timeout_ms: u32) -> u8 {
        input       := GetStdHandle(STD_INPUT_HANDLE)
        wait_result := WaitForSingleObject(input, timeout_ms.as(DWORD))

        on wait_result != WAIT_OBJECT_0 => return 0
        return term_read_byte()
    }

    term_input_is_console :: fn () -> bool {
        input         := GetStdHandle(STD_INPUT_HANDLE)
        mode  : DWORD

        return GetConsoleMode(input, ^mode) != 0
    }

    term_windows_virtual_key :: fn (virtual_key: u16) -> ?TermScanCode {
        vk := virtual_key.as(u32)
        on vk >= '0'.as(u32) && vk <= '9'.as(u32) => return vk.as(TermScanCode)
        on vk >= 'A'.as(u32) && vk <= 'Z'.as(u32) => return vk.as(TermScanCode)
        return on virtual_key {
            VK_BACK      => Backspace
            VK_TAB       => Tab
            VK_RETURN    => Enter
            VK_ESCAPE    => Escape
            VK_SPACE     => Space
            VK_PRIOR     => PageUp
            VK_NEXT      => PageDown
            VK_END       => End
            VK_HOME      => Home
            VK_LEFT      => ArrowLeft
            VK_UP        => ArrowUp
            VK_RIGHT     => ArrowRight
            VK_DOWN      => ArrowDown
            VK_INSERT    => Insert
            VK_DELETE    => Delete
            VK_NUMPAD0   => Numpad0
            VK_NUMPAD1   => Numpad1
            VK_NUMPAD2   => Numpad2
            VK_NUMPAD3   => Numpad3
            VK_NUMPAD4   => Numpad4
            VK_NUMPAD5   => Numpad5
            VK_NUMPAD6   => Numpad6
            VK_NUMPAD7   => Numpad7
            VK_NUMPAD8   => Numpad8
            VK_NUMPAD9   => Numpad9
            VK_MULTIPLY  => NumpadMul
            VK_ADD       => NumpadAdd
            VK_SUBTRACT  => NumpadSub
            VK_DECIMAL   => NumpadDot
            VK_DIVIDE    => NumpadDiv
            VK_F1        => F1
            VK_F2        => F2
            VK_F3        => F3
            VK_F4        => F4
            VK_F5        => F5
            VK_F6        => F6
            VK_F7        => F7
            VK_F8        => F8
            VK_F9        => F9
            VK_F10       => F10
            VK_F11       => F11
            VK_F12       => F12
            VK_LSHIFT    => LeftShift
            VK_RSHIFT    => RightShift
            VK_SHIFT     => LeftShift
            VK_LCONTROL  => LeftControl
            VK_RCONTROL  => RightControl
            VK_CONTROL   => LeftControl
            VK_LMENU     => LeftAlt
            VK_RMENU     => RightAlt
            VK_MENU      => LeftAlt
            else         => nil
        }
    }

    term_windows_input_record_key :: fn (record: INPUT_RECORD) -> ?TermScanCode {
        on record.EventType != KEY_EVENT => return nil
        on record.wVirtualKeyCode {
            VK_LEFT      => return ArrowLeft
            VK_UP        => return ArrowUp
            VK_RIGHT     => return ArrowRight
            VK_DOWN      => return ArrowDown
            VK_INSERT    => return Insert
            VK_DELETE    => return Delete
            VK_HOME      => return Home
            VK_END       => return End
            VK_PRIOR     => return PageUp
            VK_NEXT      => return PageDown
            VK_LSHIFT    => return LeftShift
            VK_RSHIFT    => return RightShift
            VK_LCONTROL  => return LeftControl
            VK_RCONTROL  => return RightControl
            VK_LMENU     => return LeftAlt
            VK_RMENU     => return RightAlt
            VK_NUMPAD0   => return Numpad0
            VK_NUMPAD1   => return Numpad1
            VK_NUMPAD2   => return Numpad2
            VK_NUMPAD3   => return Numpad3
            VK_NUMPAD4   => return Numpad4
            VK_NUMPAD5   => return Numpad5
            VK_NUMPAD6   => return Numpad6
            VK_NUMPAD7   => return Numpad7
            VK_NUMPAD8   => return Numpad8
            VK_NUMPAD9   => return Numpad9
            VK_MULTIPLY  => return NumpadMul
            VK_ADD       => return NumpadAdd
            VK_SUBTRACT  => return NumpadSub
            VK_DECIMAL   => return NumpadDot
            VK_DIVIDE    => return NumpadDiv

            else => {
            }
        }
        physical := on record.wVirtualScanCode {
            0x01  => TermScanCode.Escape
            0x02  => TermScanCode.Digit1
            0x03  => TermScanCode.Digit2
            0x04  => TermScanCode.Digit3
            0x05  => TermScanCode.Digit4
            0x06  => TermScanCode.Digit5
            0x07  => TermScanCode.Digit6
            0x08  => TermScanCode.Digit7
            0x09  => TermScanCode.Digit8
            0x0a  => TermScanCode.Digit9
            0x0b  => TermScanCode.Digit0
            0x0c  => TermScanCode.Minus
            0x0d  => TermScanCode.Equal
            0x0e  => TermScanCode.Backspace
            0x0f  => TermScanCode.Tab
            0x10  => TermScanCode.Q
            0x11  => TermScanCode.W
            0x12  => TermScanCode.E
            0x13  => TermScanCode.R
            0x14  => TermScanCode.T
            0x15  => TermScanCode.Y
            0x16  => TermScanCode.U
            0x17  => TermScanCode.I
            0x18  => TermScanCode.O
            0x19  => TermScanCode.P
            0x1a  => TermScanCode.LeftBracket
            0x1b  => TermScanCode.RightBracket
            0x1c  => TermScanCode.Enter
            0x1d  => TermScanCode.LeftControl
            0x1e  => TermScanCode.A
            0x1f  => TermScanCode.S
            0x20  => TermScanCode.D
            0x21  => TermScanCode.F
            0x22  => TermScanCode.G
            0x23  => TermScanCode.H
            0x24  => TermScanCode.J
            0x25  => TermScanCode.K
            0x26  => TermScanCode.L
            0x27  => TermScanCode.Semicolon
            0x28  => TermScanCode.Quote
            0x29  => TermScanCode.Backtick
            0x2a  => TermScanCode.LeftShift
            0x2b  => TermScanCode.Backslash
            0x2c  => TermScanCode.Z
            0x2d  => TermScanCode.X
            0x2e  => TermScanCode.C
            0x2f  => TermScanCode.V
            0x30  => TermScanCode.B
            0x31  => TermScanCode.N
            0x32  => TermScanCode.M
            0x33  => TermScanCode.Comma
            0x34  => TermScanCode.Dot
            0x35  => TermScanCode.Slash
            0x36  => TermScanCode.RightShift
            0x37  => TermScanCode.NumpadMul
            0x38  => TermScanCode.LeftAlt
            0x39  => TermScanCode.Space
            0x3a  => TermScanCode.CapsLock
            0x3b  => TermScanCode.F1
            0x3c  => TermScanCode.F2
            0x3d  => TermScanCode.F3
            0x3e  => TermScanCode.F4
            0x3f  => TermScanCode.F5
            0x40  => TermScanCode.F6
            0x41  => TermScanCode.F7
            0x42  => TermScanCode.F8
            0x43  => TermScanCode.F9
            0x44  => TermScanCode.F10
            0x45  => TermScanCode.NumLock
            0x46  => TermScanCode.ScrollLock
            0x47  => TermScanCode.Numpad7
            0x48  => TermScanCode.Numpad8
            0x49  => TermScanCode.Numpad9
            0x4a  => TermScanCode.NumpadSub
            0x4b  => TermScanCode.Numpad4
            0x4c  => TermScanCode.Numpad5
            0x4d  => TermScanCode.Numpad6
            0x4e  => TermScanCode.NumpadAdd
            0x4f  => TermScanCode.Numpad1
            0x50  => TermScanCode.Numpad2
            0x51  => TermScanCode.Numpad3
            0x52  => TermScanCode.Numpad0
            0x53  => TermScanCode.NumpadDot
            0x57  => TermScanCode.F11
            0x58  => TermScanCode.F12
            else  => TermScanCode.Unknown
        }
        on physical != TermScanCode.Unknown => return physical
        return term_windows_virtual_key(record.wVirtualKeyCode)
    }

    term_windows_modifiers :: fn (state: DWORD) -> u32 {
        modifiers : u32 = 0
        on (state & SHIFT_PRESSED.as(DWORD)) != 0 => modifiers |= TERM_MOD_SHIFT
        on (state & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED).as(DWORD)) != 0 => modifiers |= TERM_MOD_ALT
        on (state & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED).as(DWORD)) != 0 => modifiers |= TERM_MOD_CONTROL
        on (state & NUMLOCK_ON.as(DWORD)) != 0 => modifiers |= TERM_MOD_NUM_LOCK
        on (state & CAPSLOCK_ON.as(DWORD)) != 0 => modifiers |= TERM_MOD_CAPS_LOCK
        return modifiers
    }

    term_windows_mouse_buttons :: fn (button_state: DWORD) -> u32 {
        buttons : u32 = 0
        on (button_state & FROM_LEFT_1ST_BUTTON_PRESSED.as(DWORD)) != 0 => buttons |= TERM_MOUSE_LEFT
        on (button_state & RIGHTMOST_BUTTON_PRESSED.as(DWORD)) != 0 => buttons |= TERM_MOUSE_RIGHT
        on (button_state & FROM_LEFT_2ND_BUTTON_PRESSED.as(DWORD)) != 0 => buttons |= TERM_MOUSE_MIDDLE
        on (button_state & FROM_LEFT_3RD_BUTTON_PRESSED.as(DWORD)) != 0 => buttons |= TERM_MOUSE_X1
        on (button_state & FROM_LEFT_4TH_BUTTON_PRESSED.as(DWORD)) != 0 => buttons |= TERM_MOUSE_X2
        return buttons
    }

    term_windows_mouse_wheel_delta :: fn (button_state: DWORD) -> i32 {
        high := ((button_state >> 16) & 0xffff).as(u32)
        return on high >= 0x8000 => high.as(i32) - 0x10000 else high.as(i32)
    }

    term_windows_input_record_mouse :: fn (record: INPUT_RECORD) -> TermInputEvent {
        on record.EventType != MOUSE_EVENT => return TermInputEvent.None

        mouse := (^record).as(^MOUSE_INPUT_RECORD)
        x     := mouse^.dwMousePosition.X.as(i32)
        y     := mouse^.dwMousePosition.Y.as(i32)

        on (mouse^.dwEventFlags & MOUSE_WHEELED.as(DWORD)) != 0 => {
            delta := term_windows_mouse_wheel_delta(mouse^.dwButtonState)
            return on delta > 0
                =>   TermInputEvent.MouseWheel(x, y, 0, 1)
                else on (delta < 0)
                =>   TermInputEvent.MouseWheel(x, y, 0, -1)
                else TermInputEvent.None
        }

        on (mouse^.dwEventFlags & MOUSE_HWHEELED.as(DWORD)) != 0 => {
            delta := term_windows_mouse_wheel_delta(mouse^.dwButtonState)
            return on delta > 0
                =>   TermInputEvent.MouseWheel(x, y, 1, 0)
                else on (delta < 0)
                =>   TermInputEvent.MouseWheel(x, y, -1, 0)
                else TermInputEvent.None
        }

        buttons  := term_windows_mouse_buttons(mouse^.dwButtonState)
        pressed  := buttons & ~term_mouse.buttons
        released := term_mouse.buttons & ~buttons

        on pressed != 0 => return TermInputEvent.MouseDown(x, y, pressed)
        on released != 0 => return TermInputEvent.MouseUp(x, y, released)
        on (mouse^.dwEventFlags & MOUSE_MOVED.as(DWORD)) != 0 => return TermInputEvent.MouseMove(x, y)

        return TermInputEvent.None
    }

    term_windows_console_key :: fn () -> ?TermScanCode {
        input              := GetStdHandle(STD_INPUT_HANDLE)
        mode       : DWORD
        is_console         := GetConsoleMode(input, ^mode)

        on is_console == 0 => return nil

        for {
            record       : INPUT_RECORD
            records_read : DWORD

            ok := ReadConsoleInput(input, ^record, 1, ^records_read)
            on ok == 0 || records_read == 0 => return nil

            key := term_windows_input_record_key(record)
            on key => {
                on record.bKeyDown != 0 => return key
            }
        }
        return nil
    }

    -- Reads one translated terminal key.
    pub term_get_key :: fn () -> ?TermScanCode {
        key := term_windows_console_key()
        on key => return key
            else {
            byte := term_read_byte()
            on byte == 0 => return nil
            return term_scan_code_from_codepoint(byte.as(u32))
        }
    }

    term_windows_console_event :: fn () -> TermInputEvent {
        input              := GetStdHandle(STD_INPUT_HANDLE)
        mode       : DWORD
        is_console         := GetConsoleMode(input, ^mode)

        on is_console == 0 => return TermInputEvent.None

        for {
            wait_result := WaitForSingleObject(input, 0)
            on wait_result != WAIT_OBJECT_0 => return TermInputEvent.None

            record       : INPUT_RECORD
            records_read : DWORD

            ok := ReadConsoleInput(input, ^record, 1, ^records_read)
            on ok == 0 || records_read == 0 => return TermInputEvent.None

            key := term_windows_input_record_key(record)
            on key {
                code => {
                    action := on record.bKeyDown == 0
                        =>   TermKeyAction.Release
                        else on (term_key_down(term_keyboard_snapshot(), code))
                        =>   TermKeyAction.Repeat
                        else TermKeyAction.Press
                    character : ?u32 = nil
                    on record.UnicodeChar > 0 => {
                        character = record.UnicodeChar.as(u32)
                    }
                    return term_key_event(code,
                                          action,
                                          term_windows_modifiers(record.dwControlKeyState),
                                          character)
                }

                else => {
                }
            }

            mouse := term_windows_input_record_mouse(record)
            on mouse {
                TermInputEvent.None => {
                }

                else => return mouse
            }
        }
        return TermInputEvent.None
    }

    term_read_input_event_impl :: fn () -> TermInputEvent {
        event := term_windows_console_event()
        on term_input_is_console() => return event

        on event {
            TermInputEvent.None => {
                byte := term_read_byte_timeout(0)
                return on byte == 0
                    =>   TermInputEvent.None
                    else term_input_event_from_codepoint(term_read_utf8_codepoint(byte))
            }

            else => return event
        }
    }

    term_keyboard_protocol_enable_impl :: fn () {
        on term_input_is_console() => {
            term_keyboard_caps = TermKeyboardCapabilities {
                physical_keys   : yes
                key_releases    : yes
                modifiers       : yes
                associated_text : yes
            }
        } else {
            term_keyboard_caps = TermKeyboardCapabilities {
                physical_keys   : no
                key_releases    : no
                modifiers       : no
                associated_text : no
            }
            term_print("\x1b[>31u\x1b[?u")
        }
    }

    term_keyboard_protocol_disable_impl :: fn () {
        on !term_input_is_console() => term_print("\x1b[<u")
    }

    term_wait_for_input_impl :: fn (timeout_ms: i32) {
        input := GetStdHandle(STD_INPUT_HANDLE)
        wait_ms := on timeout_ms < 0
            =>   0xffffffff.as(DWORD)
            else timeout_ms.as(DWORD)
        _ := WaitForSingleObject(input, wait_ms)
    }

}
