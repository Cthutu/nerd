-- Nerd Standard Library (NSL)
--
-- Copyright (c) 2026 Matt Davies
--
-- Windows desktop integration through os.windows.

on "windows" {

    use os.windows

    -- Converts validated UTF-8 to terminated temporary UTF-16.
    wide_text :: fn (text: string) -> ^u16\SystemError {
        on text.count == 0 => {
            empty := temp_arena.alloc_array[u16](1)
            empty[0] = 0
            return empty.data
        }
        size := MultiByteToWideChar(CP_UTF8,
                                    8,
                                    text.data,
                                    text.count.as(i32),
                                    nil,
                                    0)
        on size <= 0 => return SystemError.Failed { code: GetLastError() }!
        output := temp_arena.alloc_array[u16](size.as(usize) + 1)
        _      := MultiByteToWideChar(CP_UTF8, 8, text.data, text.count.as(i32), output.data, size)

        output[size.as(usize)] = 0
        return output.data
    }

    -- Copies a terminated Windows path into caller-selected UTF-8 storage.
    narrow_text :: fn (text: ^u16, output_arena: ^arena) -> string\SystemError {
        size := WideCharToMultiByte(CP_UTF8, 0, text, -1, nil, 0, nil, nil)
        on size <= 0 => return SystemError.Failed { code: GetLastError() }!
        output := output_arena.alloc_bytes(size.as(usize))
        on WideCharToMultiByte(CP_UTF8, 0, text, -1, output.data, size, nil, nil) != size => return SystemError.Failed { code: GetLastError() }!
        return output[..size.as(usize) - 1].as(string)
    }

    -- Resolves local paths once and normalises separators for the Windows shell.
    windows_shell_path :: fn (path: string) -> ^u16\SystemError {
        input         := wide_text(path)?
        index : usize = 0

        for input[index] != 0 {
            on input[index] == 47 => input[index] = 92
            index += 1
        }
        -- Use one resolution call so relative paths observe the current directory
        -- only once. The Windows path limit includes the terminating NUL.
        output := temp_arena.alloc_array[u16](32768)
        size   := GetFullPathNameW(input, output.count.as(u32), output.data, nil)

        on size == 0 => return SystemError.Failed { code: GetLastError() }!
        on size.as(usize) >= output.count => return SystemError.Invalid!
        return output.data
    }

    -- Opens a normalised absolute filesystem path through the desktop shell.
    native_open_path :: fn (path: string) -> void\SystemError {
        return shell_open(windows_shell_path(path)?)
    }

    -- Opens a browser URI without applying filesystem path conversion.
    native_open :: fn (target: string) -> void\SystemError {
        return shell_open(wide_text(target)?)
    }

    -- Balances COM initialisation around a native shell launch.
    shell_open :: fn (text: ^u16) -> void\SystemError {
        initialised := CoInitializeEx(nil, COINIT_APARTMENTTHREADED)
        on initialised < 0 => return SystemError.Failed { code: initialised.as(u32) }!
        defer CoUninitialize()
        -- The example exits immediately, so finish shell/DDE activation before
        -- releasing this thread's COM apartment.
        state := SHELLEXECUTEINFOW {
            cbSize : SHELLEXECUTEINFOW.size.as(u32)
            fMask  : SEE_MASK_NOASYNC | SEE_MASK_FLAG_NO_UI
            lpFile : text
            nShow  : SW_SHOWNORMAL
            ...
        }
        on ShellExecuteExW(^state) == 0 => return SystemError.Failed { code: GetLastError() }!
    }

    -- Runs a synchronous native open/save/folder picker.
    native_dialog :: fn (kind         : i32,
                         title        : string,
                         suggested    : string,
                         output_arena : ^arena) -> string\SystemError {
        prompt      := wide_text(title)?
        initialised := CoInitializeEx(nil, COINIT_APARTMENTTHREADED)

        on initialised < 0 => return SystemError.Failed { code: initialised.as(u32) }!
        defer CoUninitialize()
        path := temp_arena.alloc_array[u16](32768)
        path[0] = 0
        on kind == 2 => {
            display : [260]u16
            state              := BROWSEINFOW { pszDisplayName: display.data lpszTitle: prompt ulFlags: BIF_RETURNONLYFSDIRS | BIF_EDITBOX | BIF_NEWDIALOGSTYLE ... }
            item               := SHBrowseForFolderW(^state)

            on item == nil => return SystemError.Cancelled!
            defer CoTaskMemFree(item)
            on SHGetPathFromIDListW(item, path.data) == 0 => return SystemError.Failed { code: 0 }!
            return narrow_text(path.data, output_arena)
        }
        initial         := wide_text(suggested)?
        count   : usize = 0

        for initial[count] != 0 {
            count += 1
        }
        on count >= path.count => return SystemError.Invalid!
        for i: usize = 0; i <= count; i += 1 {
            path[i] = initial[i]
        }
        state := OPENFILENAMEW {
            lStructSize : OPENFILENAMEW.size.as(u32)
            lpstrFile   : path.data
            nMaxFile    : path.count.as(u32)
            lpstrTitle  : prompt
            Flags       : OFN_EXPLORER | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR
            ...
        }
        accepted : i32
        on kind == 0 => {
            state.Flags |= OFN_FILEMUSTEXIST
            accepted = GetOpenFileNameW(^state)
        } else {
            state.Flags |= OFN_OVERWRITEPROMPT
            accepted = GetSaveFileNameW(^state)
        }
        on accepted == 0 => {
            code := CommDlgExtendedError()
            on code == 0 => return SystemError.Cancelled!
            return SystemError.Failed { code }!
        }
        return narrow_text(path.data, output_arena)
    }

}

on "windows" {

    test "desktop paths round trip Unicode and retain whitespace" {
        mark := temp_arena.mark()
        defer temp_arena.restore(mark)
        text := " C:/界/𐍈 document.txt "
        wide := wide_text(text) else {
            assert no
            return
        }
        copied := narrow_text(wide, temp_arena) else {
            assert no
            return
        }
        assert copied == text, "Desktop paths must round trip through UTF-16"
        empty := wide_text("") else {
            assert no
            return
        }
        assert empty[0] == 0, "Empty titles must be terminated"
    }

}

on "windows" {

    test "Windows shell paths resolve dot paths and native separators" {
        mark := temp_arena.mark()
        defer temp_arena.restore(mark)
        current := windows_shell_path(".") else {
            assert no
            return
        }
        slash := windows_shell_path("./.") else {
            assert no
            return
        }
        backslash := windows_shell_path(".\\.") else {
            assert no
            return
        }
        current_text := narrow_text(current, temp_arena) else {
            assert no
            return
        }
        slash_text := narrow_text(slash, temp_arena) else {
            assert no
            return
        }
        backslash_text := narrow_text(backslash, temp_arena) else {
            assert no
            return
        }
        assert is_absolute(current_text), "Shell paths must be absolute"
        assert current_text == slash_text && current_text == backslash_text,
            "Dot paths must resolve to the same current directory"
        for byte in current_text {
            assert byte^ != 47, "Shell paths must use Windows separators"
        }
        unicode := windows_shell_path("C:/界 folder/𐍈.txt") else {
            assert no
            return
        }
        unicode_text := narrow_text(unicode, temp_arena) else {
            assert no
            return
        }
        assert unicode_text == "C:\\界 folder\\𐍈.txt",
            "Shell conversion must retain spaces and Unicode"
    }

}
