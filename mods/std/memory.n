use os.windows

-- Copy bytes from one location to another
copy :: fn (src: []u8, dst: []u8) -> usize {
    assert src.count == dst.count,
        "Source and destination arrays must be of "
        +"the same size"

    on "windows" {
        src_pointer := src.data
        dst_pointer := dst.data
        length      := src.bytes

        CopyMemory(dst_pointer, src_pointer, length)
        return length
    }

    on "linux" {
        src_pointer := src.data
        dst_pointer := dst.data
        length      := src.bytes

        for i in [0 .. length] {
            dst_pointer[i] = src_pointer[i]
        }
        return length
    }
}

test "copy" {
    src : [5]u8 = [1, 2, 3, 4, 5]
    dst : [5]u8 = [0, 0, 0, 0, 0]

    bytes_copied := copy(src, dst)
    assert bytes_copied == 5,
        "Expected 5 bytes to be copied, but got {bytes_copied}"
    assert dst[0] == 1 && dst[1] == 2 && dst[2] == 3 && dst[3] == 4 && dst[4] == 5,
        "Expected destination array to contain the copied bytes"
}

-- Move bytes from one location to another.  Will deal with overlapping memory
-- areas by choosing the correct direction to copy.
move :: fn (src: []u8, dst: []u8) -> usize {
    assert src.count == dst.count,
        "Source and destination arrays must be of "
        +"the same size"

    on "windows" {
        src_pointer := src.data
        dst_pointer := dst.data
        length      := src.bytes

        MoveMemory(dst_pointer, src_pointer, length)
        return length
    }

    on "linux" {
        src_pointer := src.data
        dst_pointer := dst.data
        length      := src.bytes

        on dst_pointer < src_pointer => {
            for i in [0 .. length] {
                dst_pointer[i] = src_pointer[i]
            }
        } else {
            for i in [0 .. length] {
                dst_pointer[length - 1 - i] = src_pointer[length - 1 - i]
            }
        }
        return length
    }
}

test "move-forward" {
    data : []u8 = [1, 2, 3, 4, 5, 6, 7]
    src         := data[0..5]  -- [1, 2, 3, 4, 5]
    dst         := data[2..7]  -- [3, 4, 5, 6, 7]

    bytes_moved := move(src, dst)
    assert bytes_moved == 5,
        "Expected 5 bytes to be moved, but got {bytes_moved}"
    assert data == [1, 2, 1, 2, 3, 4, 5],
        "Expected data array to contain the moved bytes"
}

test "move-backward" {
    data : []u8 = [1, 2, 3, 4, 5, 6, 7]
    src         := data[2..7]  -- [3, 4, 5, 6, 7]
    dst         := data[0..5]  -- [1, 2, 3, 4, 5]

    bytes_moved := move(src, dst)
    assert bytes_moved == 5,
        "Expected 5 bytes to be moved, but got {bytes_moved}"
    assert data == [3, 4, 5, 6, 7, 6, 7],
        "Expected data array to contain the moved bytes"
}

-- Fill an area of bytes with a particular byte value
fill :: fn (dst: []u8, value: u8) -> usize {
    on "windows" {
        dst_pointer := dst.data
        length      := dst.bytes

        FillMemory(dst_pointer, length, value)
        return length
    }

    on "linux" {
        dst_pointer := dst.data
        length      := dst.bytes

        for i in [0 .. length] {
            dst_pointer[i] = value
        }
        return length
    }
}

test "fill" {
    data : [5]u8 = [0, 0, 0, 0, 0]

    bytes_filled := fill(data, 42)
    assert bytes_filled == 5,
        "Expected 5 bytes to be filled, but got {bytes_filled}"
    assert data == [42, 42, 42, 42, 42],
        "Expected data array to contain the filled bytes"
}

-- Zero an area of bytes
zero :: fn (dst: []u8) -> usize {
    on "windows" {
        dst_pointer := dst.data
        length      := dst.bytes

        FillMemory(dst_pointer, length, 0)
        return length
    }

    on "linux" {
        dst_pointer := dst.data
        length      := dst.bytes

        for i in [0 .. length] {
            dst_pointer[i] = 0
        }
        return length
    }
}

test "zero" {
    data : [5]u8 = [1, 2, 3, 4, 5]

    bytes_zeroed := zero(data)
    assert bytes_zeroed == 5,
        "Expected 5 bytes to be zeroed, but got {bytes_zeroed}"
    assert data == [0, 0, 0, 0, 0],
        "Expected data array to contain the zeroed bytes"
}

-- Compare two slices for equality
equal :: fn (a: []u8, b: []u8) -> bool {
    on a.size != b.size => return no

    for i in [0 .. a.count] {
        on a[i] != b[i] => return no
    }

    return yes
}

test "equal" {
    a : [5]u8 = [1, 2, 3, 4, 5]
    b : [5]u8 = [1, 2, 3, 4, 5]
    c : [5]u8 = [1, 2, 3, 4, 6]
    d : [4]u8 = [1, 2, 3, 4]

    assert equal(a, b), "Expected a and b to be equal"
    assert !equal(a, c), "Expected a and c to be not equal"
    assert !equal(a, d), "Expected a and d to be not equal"
}

-- Compare two slices, returning the the difference of the first different bytes
-- (first - last), otherwise return 0.
compare :: fn (a: []u8, b: []u8) -> i32 {
    min_count := on a.count < b.count => ${
        break a.count
    } else ${
        break b.count
    }
    on {
        a.count == 0 && a.count == 0  => return 0
        a.count == 0                  => return -(b[0].as(i32))
        b.count == 0                  => return a[0].as(i32)
        a.count > min_count           => return a[min_count].as(i32)
        b.count > min_count           => return -(b[min_count].as(i32))
        else => {
            for i in [0 .. min_count] {
                aa := a[i].as(i32)
                bb := b[i].as(i32)

                on aa != bb => return aa - bb
            }
            return 0
        }
    }
}

test "compare" {
    a      : [5]u8 = [1, 2, 3, 4, 5]
    b      : [5]u8 = [1, 2, 3, 4, 5]
    higher : [5]u8 = [1, 2, 4, 4, 5]
    prefix : [3]u8 = [1, 2, 3]
    empty  : [0]u8 = []

    assert compare(a, b) == 0, "Expected equal slices to compare as 0"
    assert compare(higher, a) == 1,
        "Expected the first differing byte to produce a positive result"
    assert compare(a, higher) == -1,
        "Expected the first differing byte to produce a negative result"
    assert compare(a, prefix) == 4,
        "Expected the first byte after a shared prefix"
    assert compare(prefix, a) == -4,
        "Expected a shorter shared prefix to compare negatively"
    assert compare(empty, empty) == 0,
        "Expected empty slices to compare as equal"
}

-- Compares the start of given data with the prefix
starts_with :: fn (data: []u8, prefix: []u8) -> bool {
    on data.count < prefix.count => return no

    for i in [0 .. prefix.count] {
        on data[i] != prefix[i] => return no
    }

    return yes
}

test "starts_with" {
    data   : [5]u8 = [1, 2, 3, 4, 5]
    prefix : [3]u8 = [1, 2, 3]
    wrong  : [3]u8 = [1, 2, 4]
    longer : [6]u8 = [1, 2, 3, 4, 5, 6]

    assert starts_with(data, prefix),
        "Expected data to start with the given prefix"
    assert !starts_with(data, wrong),
        "Expected data to not start with the wrong prefix"
    assert !starts_with(data, longer),
        "Expected data to not start with a longer prefix"
}

ends_with :: fn (data: []u8, suffix: []u8) -> bool {
    on data.count < suffix.count => return no

    offset := data.count - suffix.count
    for i in [0 .. suffix.count] {
        on data[offset + i] != suffix[i] => return no
    }

    return yes
}

test "ends_with" {
    data   : [5]u8 = [1, 2, 3, 4, 5]
    suffix : [3]u8 = [3, 4, 5]
    wrong  : [3]u8 = [2, 3, 4]
    longer : [6]u8 = [0, 1, 2, 3, 4, 5]

    assert ends_with(data, suffix), "Expected data to end with the given suffix"
    assert !ends_with(data, wrong),
        "Expected data to not end with the wrong suffix"
    assert !ends_with(data, longer),
        "Expected data to not end with a longer suffix"
}

-- Runtime-backed heap allocation and allocation diagnostics.

RUNTIME_HEAP_ALIGNMENT :: 16

-- Imports the runtime heap allocation and tracking API.
ffi "nrt" {
    nrt_mem_alloc (size: usize, alignment: usize, file: ^u8, line: u32) -> ^u8

    nrt_mem_realloc (memory    : ^void,
                     size      : usize,
                     alignment : usize,
                     file      : ^u8,
                     line      : u32) -> ^u8

    nrt_mem_free (memory: ^void)

    nrt_mem_size (memory: ^void) -> usize

    nrt_mem_leak (memory: ^void)

    nrt_mem_break_on_alloc (index: u64)
}

-- Converts kibibytes to bytes.
pub kb :: fn (n: usize) -> usize {
    return n * 1024
}

-- Converts mebibytes to bytes.
pub mb :: fn (n: usize) -> usize {
    return kb(n) * 1024
}

-- Converts gibibytes to bytes.
pub gb :: fn (n: usize) -> usize {
    return mb(n) * 1024
}

-- Rounds value up to a multiple of alignment, which must be nonzero. The
-- rounded result must fit in usize.
pub align_up :: fn (value: usize, alignment: usize) -> usize {
    assert alignment != 0, "Alignment must be nonzero"
    remainder := value % alignment
    on remainder == 0 => return value
    return value + alignment - remainder
}

on "debug" {

    -- Mirrors the runtime heap debug header used by tracked allocations.
    NrtHeapDebugHeader :: plex #c {
        prev           ^NrtHeapDebugHeader  -- Previous live runtime allocation.
        next           ^NrtHeapDebugHeader  -- Next live runtime allocation.
        source_path    string               -- Source file that requested
                                            --     allocation.
        requested_size usize                -- Number of bytes requested.
        index          u64                  -- Process-local allocation index.
        line           u32                  -- Source line that requested
                                            --     allocation.
    }

    -- Imports the runtime debug allocation list head.
    ffi "nrt" {
        nrt_mem_live_head () -> ^NrtHeapDebugHeader
    }

    -- Mirrors the runtime arena debug node used by tracked arenas.
    NrtArenaDebugNode :: plex #c {
        prev           ^NrtArenaDebugNode  -- Previous live runtime arena.
        next           ^NrtArenaDebugNode  -- Next live runtime arena.
        base           ^void               -- Reserved arena base address.
        reserved_size  usize               -- Number of bytes reserved.
        committed_size usize               -- Number of bytes committed.
        used_size      usize               -- Number of bytes currently used.
        source_path    string              -- Source file that created this
                                           --     arena.
        index          u64                 -- Process-local arena index.
        line           u32                 -- Source line that created this
                                           --     arena.
        mapping_size   usize               -- Number of bytes reserved for this
                                           --     node.
    }

    -- Imports the runtime debug arena list head.
    ffi "nrt" {
        nrt_arena_live_head () -> ^NrtArenaDebugNode
    }

}

-- Allocates size bytes with 16-byte alignment. The caller owns the returned
-- slice and must free it, including when size is zero. Do not rely on its
-- initial contents. Allocation failure terminates the process.
pub alloc :: fn (size: usize, file: string = @file, line: u32 = @line) -> []u8 {
    data := nrt_mem_alloc(size, RUNTIME_HEAP_ALIGNMENT, file.data, line)
    return data.as([]u8, size)
}

-- Resizes an entire allocation, preserving bytes up to the smaller size. The
-- returned slice replaces the old slice, which must no longer be used. A nil
-- allocation behaves like alloc. A zero size returns an empty allocation that
-- must still be freed.
pub realloc :: fn (allocation : []u8,
                   new_size   : usize,
                   file       : string = @file,
                   line       : u32 = @line) -> []u8 {
    data := nrt_mem_realloc(allocation.data.as(^void),
                            new_size,
                            RUNTIME_HEAP_ALIGNMENT,
                            file.data,
                            line)
    return data.as([]u8, new_size)
}

-- Releases an entire allocation returned by alloc or realloc. Accepts nil.
-- Borrowed slices and interior views must not be freed.
pub free :: fn (allocation: []u8) {
    nrt_mem_free(allocation.data.as(^void))
}

-- Returns the runtime-tracked size for an allocation, or zero for nil.
pub alloc_size :: fn (allocation: []u8) => nrt_mem_size(allocation.data.as(^void))

-- Records the runtime allocation index that should trigger a diagnostic
-- message.
pub break_on_alloc :: fn (index: u64) {
    nrt_mem_break_on_alloc(index)
}

-- Excludes an allocation from leak reports without freeing it. The allocation
-- remains usable and may still be freed normally.
pub leak :: fn (allocation: []u8) {
    nrt_mem_leak(allocation.data.as(^void))
}

on "debug" {

    ANSI_RESET        :: "\x1b[0m"
    ANSI_BOLD_RED     :: "\x1b[1;31m"
    ANSI_BOLD_GREEN   :: "\x1b[1;32m"
    ANSI_BOLD_YELLOW  :: "\x1b[1;33m"
    ANSI_BOLD_BLUE    :: "\x1b[1;34m"
    ANSI_BOLD_MAGENTA :: "\x1b[1;35m"
    ANSI_BOLD_CYAN    :: "\x1b[1;36m"
    ANSI_BOLD_WHITE   :: "\x1b[1;37m"
    ANSI_DIM          :: "\x1b[2m"

    -- Prints reportable live runtime allocations to stderr.
    pub print_leaks :: fn (show_message_on_no_leaks: bool = no) {
        heap_current  := nrt_mem_live_head()
        arena_current := nrt_arena_live_head()

        on heap_current == nil &&
            arena_current == nil => {
            on show_message_on_no_leaks => eprn($"{ANSI_BOLD_GREEN}std.memory: no memory leaks detected{ANSI_RESET}")
            return
        }

        heap_count      : usize
        heap_leaked     : usize
        arena_count     : usize
        arena_committed : usize

        eprn($"{ANSI_BOLD_RED}std.memory: memory leaks detected{ANSI_RESET}")
        for heap_current != nil {
            eprn($"  {ANSI_BOLD_YELLOW}heap{ANSI_RESET} {ANSI_DIM}#{heap_current.index}{ANSI_RESET} {heap_current.source_path}:{heap_current.line} {ANSI_BOLD_YELLOW}{heap_current.requested_size} bytes{ANSI_RESET}")
            heap_count   += 1
            heap_leaked  += heap_current.requested_size
            heap_current = heap_current.next
        }
        for arena_current != nil {
            eprn($"  {ANSI_BOLD_CYAN}arena{ANSI_RESET} {ANSI_DIM}#{arena_current.index}{ANSI_RESET} {arena_current.source_path}:{arena_current.line} {ANSI_BOLD_CYAN}{arena_current.used_size} bytes used{ANSI_RESET}, {arena_current.committed_size} bytes committed")
            arena_count     += 1
            arena_committed += arena_current.committed_size
            arena_current   = arena_current.next
        }
        eprn($"{ANSI_BOLD_RED}std.memory:{ANSI_RESET} total {ANSI_BOLD_YELLOW}{heap_count} heap leaks, {heap_leaked} bytes{ANSI_RESET}; {ANSI_BOLD_CYAN}{arena_count} arena leaks, {arena_committed} bytes committed{ANSI_RESET}")
    }

}

on "release" {

    -- Leak reporting is disabled in release builds; retain the same API.
    pub print_leaks :: fn (show_message_on_no_leaks: bool = no) {
        _ := show_message_on_no_leaks
    }

}

test "alloc returns runtime-backed byte slice" {
    bytes := alloc(8)
    defer free(bytes)

    assert bytes.count == 8
    assert alloc_size(bytes) == 8
}

test "alloc_size returns zero for nil allocation" {
    bytes : []u8 = nil

    assert alloc_size(bytes) == 0
}

test "byte unit helpers return byte counts" {
    assert kb(2) == 2048
    assert mb(2) == 2_097_152
    assert gb(1) == 1_073_741_824
}

test "align_up rounds to the next multiple" {
    assert align_up(16, 8) == 16
    assert align_up(17, 8) == 24
}

test "realloc updates runtime-tracked size" {
    bytes := alloc(4)
    bytes[0] = 42

    resized := realloc(bytes, 12)
    defer free(resized)

    assert resized.count == 12
    assert alloc_size(resized) == 12
    assert resized[0] == 42
}

test "free accepts nil allocation" {
    bytes : []u8 = nil

    free(bytes)
}

test "leak excludes allocation from reports while remaining freeable" {
    bytes := alloc(7)

    leak(bytes)
    free(bytes)
}

test "alloc alignment and zero size" {
    bytes := alloc(17)
    defer free(bytes)
    assert bytes.data.as(usize) % 16 == 0,
        "Expected runtime allocations to be aligned to 16 bytes"

    empty := alloc(0)
    defer free(empty)
    assert empty.count == 0 && alloc_size(empty) == 0,
        "Expected a zero-sized allocation to report no bytes"
}

test "realloc preserves bytes when shrinking and accepts nil" {
    bytes := realloc(nil, 8)
    for i in [0 .. bytes.count] {
        bytes[i] = (i + 1).as(u8)
    }
    bytes = realloc(bytes, 3)
    assert bytes.count == 3 && alloc_size(bytes) == 3,
        "Expected shrinking to update the slice and tracked allocation sizes"
    assert bytes[0] == 1 && bytes[1] == 2 && bytes[2] == 3,
        "Expected shrinking to preserve the retained bytes"

    bytes = realloc(bytes, 0)
    defer free(bytes)
    assert bytes.count == 0 && alloc_size(bytes) == 0,
        "Expected resizing to zero to return an empty, freeable allocation"
}

test "align_up handles zero and non-power-of-two alignments" {
    assert align_up(0, 8) == 0, "Expected zero to remain aligned"
    assert align_up(7, 1) == 7, "Expected alignment one to preserve the value"
    assert align_up(7, 3) == 9, "Expected arbitrary positive alignments to work"
    assert kb(0) == 0 && mb(0) == 0 && gb(0) == 0,
        "Expected zero units to contain zero bytes"
}

on "debug" {

    test "leak unlinks tracked allocation without freeing storage" {
        previous := nrt_mem_live_head()
        bytes    := alloc(7)

        assert nrt_mem_live_head() != previous,
            "Expected a heap allocation to enter the debug allocation list"
        leak(bytes)
        assert nrt_mem_live_head() == previous,
            "Expected an intentional allocation to leave the reportable list"
        bytes[0] = 42
        assert bytes[0] == 42 && alloc_size(bytes) == 7,
            "Expected an excluded allocation to remain usable"
        free(bytes)
        assert nrt_mem_live_head() == previous,
            "Expected freeing an excluded allocation to preserve the list"
    }

}

on "debug" {

    test "alloc records diagnostic source metadata" {
        bytes := alloc(3, file = "memory-test", line = 123)
        defer free(bytes)
        header := nrt_mem_live_head()
        assert header.requested_size == 3 && header.line == 123,
            "Expected allocation diagnostics to retain size and line"
        assert header.source_path == "memory-test",
            "Expected allocation diagnostics to retain the source path"
    }

}
