pub VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME ::
                                                     c"VK_KHR_portability_enumeration"

-- Common device extensions
pub VK_KHR_SWAPCHAIN_SPEC_VERSION              : u32 : 70
pub VK_EXT_MEMORY_BUDGET_SPEC_VERSION          : u32 : 1
pub VK_EXT_DESCRIPTOR_INDEXING_SPEC_VERSION    : u32 : 2
pub VK_EXT_EXTENDED_DYNAMIC_STATE_SPEC_VERSION : u32 : 1

pub VK_KHR_SWAPCHAIN_EXTENSION_NAME              :: c"VK_KHR_swapchain"
pub VK_EXT_MEMORY_BUDGET_EXTENSION_NAME          :: c"VK_EXT_memory_budget"
