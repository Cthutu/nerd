-- Common development layer names for ppEnabledLayerNames. These are Nerd
-- convenience constants for the names published by Khronos and LunarG.
pub VK_LAYER_KHRONOS_VALIDATION_LAYER_NAME :: c"VK_LAYER_KHRONOS_validation"
pub VK_LAYER_KHRONOS_PROFILES_LAYER_NAME   :: c"VK_LAYER_KHRONOS_profiles"
pub VK_LAYER_LUNARG_API_DUMP_LAYER_NAME    :: c"VK_LAYER_LUNARG_api_dump"
pub VK_LAYER_LUNARG_MONITOR_LAYER_NAME     :: c"VK_LAYER_LUNARG_monitor"
pub VK_LAYER_LUNARG_SCREENSHOT_LAYER_NAME  :: c"VK_LAYER_LUNARG_screenshot"

-- Returns the instance extensions required by std.frame's window backend. The
-- pointer list uses temp_arena and remains valid until it is reset or restored
-- past this allocation. The names themselves are static C strings. Pass the
-- result to vkCreateInstance before FrameSystem.loop() resets the arena.
pub vk_get_extensions :: fn (debug: bool = no) -> []c_string {
    count : usize = 2
    on debug => count += 1
    extensions := temp_arena.alloc_array[c_string](count)
    extensions[0] = VK_KHR_SURFACE_EXTENSION_NAME
    on "linux" {
        extensions[1] = VK_KHR_XLIB_SURFACE_EXTENSION_NAME
    }

    on "windows" {
        extensions[1] = VK_KHR_WIN32_SURFACE_EXTENSION_NAME
    }

    on debug => extensions[2] = VK_EXT_DEBUG_UTILS_EXTENSION_NAME
    return extensions
}

pub VkResult :: i32

pub VK_SUCCESS                        : VkResult = 0
pub VK_NOT_READY                      : VkResult = 1
pub VK_TIMEOUT                        : VkResult = 2
pub VK_EVENT_SET                      : VkResult = 3
pub VK_EVENT_RESET                    : VkResult = 4
pub VK_INCOMPLETE                     : VkResult = 5
pub VK_ERROR_OUT_OF_HOST_MEMORY       : VkResult = -1
pub VK_ERROR_OUT_OF_DEVICE_MEMORY     : VkResult = -2
pub VK_ERROR_INITIALIZATION_FAILED    : VkResult = -3
pub VK_ERROR_DEVICE_LOST              : VkResult = -4
pub VK_ERROR_MEMORY_MAP_FAILED        : VkResult = -5
pub VK_ERROR_LAYER_NOT_PRESENT        : VkResult = -6
pub VK_ERROR_EXTENSION_NOT_PRESENT    : VkResult = -7
pub VK_ERROR_FEATURE_NOT_PRESENT      : VkResult = -8
pub VK_ERROR_INCOMPATIBLE_DRIVER      : VkResult = -9
pub VK_ERROR_TOO_MANY_OBJECTS         : VkResult = -10
pub VK_ERROR_FORMAT_NOT_SUPPORTED     : VkResult = -11
pub VK_ERROR_FRAGMENTED_POOL          : VkResult = -12
pub VK_ERROR_SURFACE_LOST_KHR         : VkResult = -1000000000
pub VK_ERROR_NATIVE_WINDOW_IN_USE_KHR : VkResult = -1000000001
pub VK_SUBOPTIMAL_KHR                 : VkResult = 1000001003
pub VK_ERROR_OUT_OF_DATE_KHR          : VkResult = -1000001004

-- Returns a human-readable description of a Vulkan result. Unknown results
-- include their numeric code in temp_arena storage, valid until the arena is
-- reset or restored past this allocation. Known descriptions are static
-- strings.
pub vk_result_to_string :: fn (result: VkResult) -> string {
    return on result {
        VK_SUCCESS                         => "Operation completed successfully"
        VK_NOT_READY                       => "Operation has not completed yet"
        VK_TIMEOUT                         => "Timed out waiting for the "
            +"operation"
        VK_EVENT_SET                       => "Event is signalled"
        VK_EVENT_RESET                     => "Event is not signalled"
        VK_INCOMPLETE                      => "Output array is too small for "
            +"all results"
        VK_ERROR_OUT_OF_HOST_MEMORY        => "Unable to allocate host memory"
        VK_ERROR_OUT_OF_DEVICE_MEMORY      => "Unable to allocate device memory"
        VK_ERROR_INITIALIZATION_FAILED     => "Vulkan object initialisation "
            +"failed"
        VK_ERROR_DEVICE_LOST               => "Connection to the Vulkan device "
            +"was lost"
        VK_ERROR_MEMORY_MAP_FAILED         => "Unable to map memory for host "
            +"access"
        VK_ERROR_LAYER_NOT_PRESENT         => "A requested layer is missing or "
            +"could not be loaded"
        VK_ERROR_EXTENSION_NOT_PRESENT     => "A requested extension is not "
            +"supported"
        VK_ERROR_FEATURE_NOT_PRESENT       => "A requested device feature is "
            +"not supported"
        VK_ERROR_INCOMPATIBLE_DRIVER       => "The driver is incompatible with "
            +"the requested Vulkan configuration"
        VK_ERROR_TOO_MANY_OBJECTS          => "The limit for objects of this "
            +"type has been reached"
        VK_ERROR_FORMAT_NOT_SUPPORTED      => "The device does not support the "
            +"requested format"
        VK_ERROR_FRAGMENTED_POOL           => "Memory pool fragmentation "
            +"prevented allocation"
        VK_ERROR_SURFACE_LOST_KHR          => "The presentation surface is no "
            +"longer available"
        VK_ERROR_NATIVE_WINDOW_IN_USE_KHR  => "The window is already in use by "
            +"another surface or graphics API"
        VK_SUBOPTIMAL_KHR                  => "The swapchain still works but "
            +"no longer fully matches the surface"
        VK_ERROR_OUT_OF_DATE_KHR           => "The surface has changed; "
            +"recreate the swapchain"
        else                               => temp_arena.pr(text = $"Unknown Vulkan result ({result})")
    }
}

-- Vulkan structure that contains your application information.
pub VkApplicationInfo :: plex #c {
    sType              vkStructureType  -- Specifies the type of this structure
                                        --     (always use
                                        --     VK_STRUCTURE_TYPE_APPLICATION_INFO).
    pNext              ^void            -- Pointer to extension-specific
                                        --     structure.
    pApplicationName   c_string         -- Name of the application.
    applicationVersion u32              -- Version of the application.
    pEngineName        c_string         -- Name of the engine.
    engineVersion      u32              -- Version of the engine.
    apiVersion         u32              -- Version of the Vulkan API (use
                                        --     VK_API_VERSION_??? values).
}

-- Various type identifiers for the different Vulkan structures.
pub vkStructureType :: i32

pub VK_STRUCTURE_TYPE_APPLICATION_INFO     : vkStructureType = 0
pub VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO : vkStructureType = 1

-- Vulkan instance creation flags
pub vkInstanceCreateFlags :: u32

-- Vulkan structure that contains configuration for the creation of a Vulkan
-- instance.
pub VkInstanceCreateInfo :: plex #c {
    sType                   vkStructureType        -- Specifies the type of this
                                                   --     structure (always use
                                                   --     VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO).
    pNext                   ^void                  -- Pointer to
                                                   --     extension-specific
                                                   --     structure.
    flags                   vkInstanceCreateFlags  -- Instance creation flags.
    pApplicationInfo        ^VkApplicationInfo     -- Pointer to an instance of
                                                   --     VkApplicationInfo
                                                   --     containing application
                                                   --     details.
    enabledLayerCount       u32                    -- Number of global layers to
                                                   --     enable.
    ppEnabledLayerNames     ^c_string              -- Pointer to an array of
                                                   --     enabled layer names.
    enabledExtensionCount   u32                    -- Number of global
                                                   --     extensions to enable.
    ppEnabledExtensionNames ^c_string              -- Pointer to an array of
                                                   --     enabled extension
                                                   --     names.
}

pub VkInstance :: ^void

--
-- FFI API to Vulkan
--

ffi "vulkan" {
    pub vkCreateInstance  (pCreateInfo : ^VkInstanceCreateInfo,
                           pAllocator  : ^void,
                           pInstance   : ^VkInstance) -> VkResult
    pub vkDestroyInstance (instance: VkInstance, pAllocator: ^void)
}
