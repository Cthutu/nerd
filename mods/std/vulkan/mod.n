-- Queue capabilities (Vulkan-Headers v1.4.357).
pub VK_QUEUE_GRAPHICS_BIT         : VkQueueFlagBits : 0x00000001
pub VK_QUEUE_COMPUTE_BIT          : VkQueueFlagBits : 0x00000002
pub VK_QUEUE_TRANSFER_BIT         : VkQueueFlagBits : 0x00000004
pub VK_QUEUE_SPARSE_BINDING_BIT   : VkQueueFlagBits : 0x00000008
pub VK_QUEUE_PROTECTED_BIT        : VkQueueFlagBits : 0x00000010
pub VK_QUEUE_VIDEO_DECODE_BIT_KHR : VkQueueFlagBits : 0x00000020
pub VK_QUEUE_VIDEO_ENCODE_BIT_KHR : VkQueueFlagBits : 0x00000040
pub VK_QUEUE_OPTICAL_FLOW_BIT_NV  : VkQueueFlagBits : 0x00000100
pub VK_QUEUE_DATA_GRAPH_BIT_ARM   : VkQueueFlagBits : 0x00000400

pub VkExtent3D :: plex #c {
    width  u32
    height u32
    depth  u32
}

pub VkQueueFamilyProperties :: plex #c {
    queueFlags                  VkQueueFlags
    queueCount                  u32
    timestampValidBits          u32
    minImageTransferGranularity VkExtent3D
}

pub impl Display for VkQueueFamilyProperties {

    show :: fn (self: Self) -> string {
        flags := [
            VK_QUEUE_GRAPHICS_BIT,
            VK_QUEUE_COMPUTE_BIT,
            VK_QUEUE_TRANSFER_BIT,
            VK_QUEUE_SPARSE_BINDING_BIT,
            VK_QUEUE_PROTECTED_BIT,
            VK_QUEUE_VIDEO_DECODE_BIT_KHR,
            VK_QUEUE_VIDEO_ENCODE_BIT_KHR,
            VK_QUEUE_OPTICAL_FLOW_BIT_NV,
            VK_QUEUE_DATA_GRAPH_BIT_ARM,
        ]
        names := [
            "graphics",
            "compute",
            "transfer",
            "sparse binding",
            "protected",
            "video decode",
            "video encode",
            "optical flow",
            "data graph",
        ]
        capabilities := ""
        remaining    := self.queueFlags

        for i, flag in flags {
            bit := flag^.as(VkQueueFlags)
            on (remaining & bit) != 0 => {
                separator := on capabilities.count == 0 => "" else ", "

                capabilities = temp_arena.pr($"{capabilities}{separator}{names[i]}")
                remaining    = remaining ^ bit
            }
        }
        on remaining != 0 => {
            separator := on capabilities.count == 0 => "" else ", "

            capabilities = temp_arena.pr($"{capabilities}{separator}unknown flags ({remaining})")
        }
        on capabilities.count == 0 => capabilities = "no capabilities"
        plural := on self.queueCount == 1 => "" else "s"
        return temp_arena.pr($"{self.queueCount} queue{plural}: {capabilities}")
    }

}

pub impl Display for VkPhysicalDevice {

    -- The name is copied into temp_arena; no stack-backed string escapes.
    show :: fn (self: Self) -> string {
        on self == nil => return "nil"
        properties : VkPhysicalDeviceProperties
        vkGetPhysicalDeviceProperties(self, ^properties)
        return temp_arena.pr(properties.deviceName.data.as(c_string).show())
    }

}

-- FFI API to Vulkan
--

ffi "vulkan" {
    pub vkCreateInstance           (pCreateInfo : ^VkInstanceCreateInfo,
                                    pAllocator  : ^void,
                                    pInstance   : ^VkInstance) -> VkResult
    pub vkDestroyInstance          (instance: VkInstance, pAllocator: ^void)
    pub vkEnumeratePhysicalDevices (instance             : VkInstance,
                                    pPhysicalDeviceCount : ^u32,
                                    pPhysicalDevices     : ^VkPhysicalDevice) -> VkResult

    -- Only logical devices created by vkCreateDevice are destroyed here.
    -- Physical devices remain owned by their instance.
    pub vkDestroyDevice               (device: VkDevice, pAllocator: ^void)
    pub vkGetPhysicalDeviceProperties (physicalDevice : VkPhysicalDevice,
                                       pProperties    : ^VkPhysicalDeviceProperties)

    -- Pass nil for pQueueFamilyProperties to query the count first.
    pub vkGetPhysicalDeviceQueueFamilyProperties (physicalDevice            : VkPhysicalDevice,
                                                  pQueueFamilyPropertyCount : ^u32,
                                                  pQueueFamilyProperties    : ^VkQueueFamilyProperties)
    pub vkDestroySurfaceKHR                      (instance   : VkInstance,
                                                  surface    : VkSurfaceKHR,
                                                  pAllocator : ^void)
}

-- Creates a surface for an applied Frame, using Vulkan's default allocator.
-- Enable the extensions from vk_get_extensions() when creating the instance.
-- pSurface must point to unused handle storage; it is cleared on failure.
-- Destroy the surface with vkDestroySurfaceKHR(instance, surface, nil) before
-- destroying the instance, and keep the Frame alive while using the surface.
pub vk_create_surface :: fn (instance : VkInstance,
                             frame    : ^Frame,
                             pSurface : ^VkSurfaceKHR) -> VkResult {
    on pSurface == nil => return VK_ERROR_INITIALIZATION_FAILED
    pSurface^ = nil
    on instance == nil || frame == nil => return VK_ERROR_INITIALIZATION_FAILED
    native := on frame.context() => [context] {
        break context
    } else return VK_ERROR_INITIALIZATION_FAILED

    result : VkResult
    on "linux" {
        result = vkCreateXlibSurfaceKHR(instance, ^{
            sType  : VK_STRUCTURE_TYPE_XLIB_SURFACE_CREATE_INFO_KHR
            dpy    : native.display
            window : native.window
            ...
        }, nil, pSurface)
    }

    on "windows" {
        result = vkCreateWin32SurfaceKHR(instance, ^{
            sType     : VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR
            hinstance : GetWindowLongPtr(native.window, GWLP_HINSTANCE).as(HINSTANCE)
            hwnd      : native.window
            ...
        }, nil, pSurface)
    }

    on result != VK_SUCCESS => pSurface^ = nil
    return result
}

on "linux" {

    use os.linux

    pub VkXlibSurfaceCreateFlagsKHR :: VkFlags

    pub VK_STRUCTURE_TYPE_XLIB_SURFACE_CREATE_INFO_KHR : vkStructureType :
                                                                           1000004000

    pub VkXlibSurfaceCreateInfoKHR :: plex #c {
        sType  vkStructureType
        pNext  ^void
        flags  VkXlibSurfaceCreateFlagsKHR
        dpy    XDisplay
        window XWindow
    }

    ffi "vulkan" {
        pub vkCreateXlibSurfaceKHR (instance    : VkInstance,
                                    pCreateInfo : ^VkXlibSurfaceCreateInfoKHR,
                                    pAllocator  : ^void,
                                    pSurface    : ^VkSurfaceKHR) -> VkResult
    }

}

on "windows" {

    use os.windows

    pub VkWin32SurfaceCreateFlagsKHR :: VkFlags

    pub VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR : vkStructureType :
                                                                            1000009000

    pub VkWin32SurfaceCreateInfoKHR :: plex #c {
        sType     vkStructureType
        pNext     ^void
        flags     VkWin32SurfaceCreateFlagsKHR
        hinstance HINSTANCE
        hwnd      HWND
    }

    ffi "vulkan" {
        pub vkCreateWin32SurfaceKHR (instance    : VkInstance,
                                     pCreateInfo : ^VkWin32SurfaceCreateInfoKHR,
                                     pAllocator  : ^void,
                                     pSurface    : ^VkSurfaceKHR) -> VkResult
    }

}
