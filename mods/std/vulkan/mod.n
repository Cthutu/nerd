pub VK_API_VERSION_1_0 : u32 = (1 << 22) | (0 << 12) | 0
pub VK_API_VERSION_1_1 : u32 = (1 << 22) | (1 << 12) | 0
pub VK_API_VERSION_1_2 : u32 = (1 << 22) | (2 << 12) | 0
pub VK_API_VERSION_1_3 : u32 = (1 << 22) | (3 << 12) | 0
pub VK_API_VERSION_1_4 : u32 = (1 << 22) | (4 << 12) | 0

-- Common Vulkan extension names and specification revisions. Source: Khronos
-- Vulkan-Headers v1.4.357 registry/vk.xml. Names are null-terminated strings
-- for ppEnabledExtensionNames. Declarations do not imply runtime availability;
-- query support before enabling.

-- Debugging and validation (instance extensions)
pub VK_EXT_DEBUG_UTILS_SPEC_VERSION         : u32 : 2
pub VK_EXT_DEBUG_REPORT_SPEC_VERSION        : u32 : 10
pub VK_EXT_VALIDATION_FEATURES_SPEC_VERSION : u32 : 6
pub VK_EXT_VALIDATION_FLAGS_SPEC_VERSION    : u32 : 3
pub VK_EXT_LAYER_SETTINGS_SPEC_VERSION      : u32 : 2

pub VK_EXT_DEBUG_UTILS_EXTENSION_NAME         :: c"VK_EXT_debug_utils"
pub VK_EXT_DEBUG_REPORT_EXTENSION_NAME        :: c"VK_EXT_debug_report"
pub VK_EXT_VALIDATION_FEATURES_EXTENSION_NAME :: c"VK_EXT_validation_features"
pub VK_EXT_VALIDATION_FLAGS_EXTENSION_NAME    :: c"VK_EXT_validation_flags"
pub VK_EXT_LAYER_SETTINGS_EXTENSION_NAME      :: c"VK_EXT_layer_settings"

-- Presentation (instance extensions)
pub VK_EXT_SWAPCHAIN_COLOR_SPACE_SPEC_VERSION   : u32 : 5
pub VK_EXT_HEADLESS_SURFACE_SPEC_VERSION        : u32 : 1
pub VK_KHR_SURFACE_SPEC_VERSION                 : u32 : 25
pub VK_KHR_XLIB_SURFACE_SPEC_VERSION            : u32 : 6
pub VK_KHR_XCB_SURFACE_SPEC_VERSION             : u32 : 6
pub VK_KHR_WAYLAND_SURFACE_SPEC_VERSION         : u32 : 6
pub VK_KHR_WIN32_SURFACE_SPEC_VERSION           : u32 : 6
pub VK_KHR_PORTABILITY_ENUMERATION_SPEC_VERSION : u32 : 1

pub VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME   ::
                                                     c"VK_EXT_swapchain_colorspace"
pub VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME        :: c"VK_EXT_headless_surface"
pub VK_KHR_SURFACE_EXTENSION_NAME                 :: c"VK_KHR_surface"
pub VK_KHR_XLIB_SURFACE_EXTENSION_NAME            :: c"VK_KHR_xlib_surface"
pub VK_KHR_XCB_SURFACE_EXTENSION_NAME             :: c"VK_KHR_xcb_surface"
pub VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME         :: c"VK_KHR_wayland_surface"
