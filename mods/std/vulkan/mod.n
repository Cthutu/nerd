-- Common Vulkan types
pub VkBool32              :: u32
pub VkFlags               :: u32
pub VkResult              :: i32
pub VkObjectType          :: i32
pub vkStructureType       :: i32
pub vkInstanceCreateFlags :: u32
pub VkInstance            :: ^void

pub VK_FALSE : VkBool32 : 0
pub VK_TRUE  : VkBool32 : 1

pub VK_API_VERSION_1_0 : u32 = (1 << 22) | (0 << 12) | 0
pub VK_API_VERSION_1_1 : u32 = (1 << 22) | (1 << 12) | 0
pub VK_API_VERSION_1_2 : u32 = (1 << 22) | (2 << 12) | 0
pub VK_API_VERSION_1_3 : u32 = (1 << 22) | (3 << 12) | 0
pub VK_API_VERSION_1_4 : u32 = (1 << 22) | (4 << 12) | 0

-- Common Vulkan extension names and specification revisions. Source: Khronos
-- Vulkan-Headers v1.4.357 registry/vk.xml. Names are null-terminated strings
-- for ppEnabledExtensionNames. Declarations do not imply runtime availability;
-- query support before enabling.

