-- Application callbacks should return VK_FALSE.
pub PFN_vkDebugUtilsMessengerCallbackEXT :: fn (messageSeverity : VkDebugUtilsMessageSeverityFlagBitsEXT,
                                                messageTypes    : VkDebugUtilsMessageTypeFlagsEXT,
                                                pCallbackData   : ^VkDebugUtilsMessengerCallbackDataEXT,
                                                pUserData       : ^void) -> VkBool32

-- Can be chained through VkInstanceCreateInfo.pNext to receive messages during
-- instance creation and destruction. flags is reserved and must be zero.
pub VkDebugUtilsMessengerCreateInfoEXT :: plex #c {
    sType           vkStructureType
    pNext           ^void
    flags           VkDebugUtilsMessengerCreateFlagsEXT
    messageSeverity VkDebugUtilsMessageSeverityFlagsEXT
    messageType     VkDebugUtilsMessageTypeFlagsEXT
    pfnUserCallback PFN_vkDebugUtilsMessengerCallbackEXT
    pUserData       ^void
}

