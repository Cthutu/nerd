    -- Invokes a syscall using libc error semantics: -1 on failure, with the
    -- error code available through last_error().
    pub syscall :: intrinsic "syscall" (number: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) -> i64

