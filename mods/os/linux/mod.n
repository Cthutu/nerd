    test "syscall" {
        assert SYS_READ == 0 && SYS_RSEQ_SLICE_YIELD == 471 && SYS_FCHROOT == 472,
            "Expected Linux x86-64 syscall numbers to match the kernel table"

        process_id := syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)
        assert process_id > 0,
            "Expected the getpid syscall to return a positive process ID"
    }

    pub CLOCK_MONOTONIC :: 1  -- Linux clock identifier for monotonic time.

    -- Represents the Linux timespec structure.
    pub TimeSpec :: plex #c {
        tv_sec  i64  -- Whole seconds.
        tv_nsec i64  -- Additional nanoseconds.
    }

    -- Reads a Linux clock into a TimeSpec.
    pub sys_clock_gettime :: fn (clock_id: i32, time: ^TimeSpec) => syscall(SYS_CLOCK_GETTIME, clock_id.as(u64), time.as(usize).as(u64), 0, 0, 0, 0).as(i32)

    -- Sleeps for the requested duration, reporting time remaining if interrupted.
    pub sys_nanosleep :: fn (request: ^TimeSpec, remaining: ^TimeSpec) => syscall(SYS_NANOSLEEP, request.as(usize).as(u64), remaining.as(usize).as(u64), 0, 0, 0, 0).as(i32)

    pub use glx
    pub use x11

    ffi "c" {
        c_errno_location :: __errno_location () -> ^i32
    }

    pub STDIN_FILENO  :: 0  -- File descriptor for standard input.
    pub STDOUT_FILENO :: 1  -- File descriptor for standard output.

    pub O_RDONLY :: 0x0000
    pub O_WRONLY :: 0x0001
    pub O_RDWR   :: 0x0002
    pub O_CREAT  :: 0x0040
    pub O_TRUNC  :: 0x0200
    pub O_APPEND :: 0x0400

    pub AT_FDCWD            :: -100
    pub AT_SYMLINK_NOFOLLOW :: 0x0100

    pub S_IFMT  :: 0xf000
    pub S_IFDIR :: 0x4000
    pub S_IFREG :: 0x8000
    pub S_IFLNK :: 0xa000

    pub ENOENT  :: 2
    pub EINTR   :: 4
    pub EACCES  :: 13
    pub EEXIST  :: 17
    pub ENOTDIR :: 20
    pub EISDIR  :: 21
    pub EINVAL  :: 22

    -- Returns the calling thread's current C library error code.
    pub last_error :: fn () => c_errno_location()^

    pub POLLIN :: 0x0001  -- File descriptor has data available to read.

    pub TIOCGWINSZ :: 0x5413
    -- Linux terminal request for reading window
    -- dimensions.
    pub TCGETS :: 0x5401
    -- Linux terminal request for reading terminal
    -- attributes.
    pub TCSETS :: 0x5402
    -- Linux terminal request for writing terminal
    -- attributes immediately.

    pub ICANON :: 0x0002  -- Local terminal mode flag for canonical input.
    pub ECHO   :: 0x0008  -- Local terminal mode flag for echoing input.
    pub ISIG   :: 0x0001
    -- Local terminal mode flag for signal-generating
    -- characters.
    pub IEXTEN :: 0x8000
    -- Local terminal mode flag for implementation-defined
    -- input processing.

    pub ICRNL :: 0x0100
    -- Input terminal mode flag for converting carriage return
    -- to newline.
    pub IXON   :: 0x0400  -- Input terminal mode flag for XON/XOFF flow control.
    pub BRKINT :: 0x0002  -- Input terminal mode flag for break interrupt
    --     handling.
    pub INPCK  :: 0x0010  -- Input terminal mode flag for parity checking.
    pub ISTRIP :: 0x0020  -- Input terminal mode flag for stripping the eighth
    --     bit.

    pub OPOST :: 0x0001  -- Output terminal mode flag for implementation-defined
    -- output processing.
    pub ONLCR :: 0x0004  -- Output terminal mode flag for mapping newline to
    -- carriage-return newline.

    pub CS8 :: 0x0030  -- Control terminal mode flag selecting 8-bit characters.

    pub VMIN  :: 6  -- Control character index for noncanonical read byte count.
    pub VTIME :: 5  -- Control character index for noncanonical read timeout.

    -- Describes terminal window dimensions for `TIOCGWINSZ`.
    pub WindowSize :: plex #c {
        row    u16  -- Number of character rows.
        col    u16  -- Number of character columns.
        xpixel u16  -- Width in pixels when provided by the terminal.
        ypixel u16  -- Height in pixels when provided by the terminal.
    }

    -- Linux terminal attributes used by `TCGETS` and `TCSETS`.
    pub Termios :: plex #c {
        iflag  u32
        oflag  u32
        cflag  u32
        lflag  u32
        line   u8
        cc     [32]u8
        ispeed u32
        ospeed u32
    }

    -- Represents one Linux pollfd entry.
    pub PollFd :: plex #c {
        fd      i32
        events  i16
        revents i16
    }

    -- Represents file metadata returned by `newfstatat` on 64-bit Linux.
    pub Stat :: plex #c {
        dev         u64     -- Identifier of the containing device.
        ino         u64     -- File serial number.
        nlink       u64     -- Number of hard links.
        mode        u32     -- File kind and permission bits.
        uid         u32     -- Owning user identifier.
        gid         u32     -- Owning group identifier.
        _padding    u32     -- Native structure padding.
        rdev        u64     -- Device identifier for special files.
        size        i64     -- File size in bytes.
        block_size  i64     -- Preferred block size for I/O.
        blocks      i64     -- Allocated 512-byte blocks.
        access_sec  i64     -- Last access time in seconds.
        access_nsec i64     -- Last access subsecond component.
        modify_sec  i64     -- Last modification time in seconds.
        modify_nsec i64     -- Last modification subsecond component.
        change_sec  i64     -- Last metadata-change time in seconds.
        change_nsec i64     -- Last metadata-change subsecond component.
        _reserved   [3]i64  -- Reserved native fields.
    }

    -- Reads bytes from a file descriptor using the Linux `read` syscall.
    pub sys_read :: fn (fd: i32, buf: ^void, count: usize) => syscall(SYS_READ, fd.as(u64), buf.as(usize).as(u64), count.as(u64), 0, 0, 0).as(isize)

    -- Writes bytes to a file descriptor using the Linux `write` syscall.
    pub sys_write :: fn (fd: i32, buf: ^void, count: usize) => syscall(SYS_WRITE, fd.as(u64), buf.as(usize).as(u64), count.as(u64), 0, 0, 0).as(isize)

    -- Opens a path using the Linux `open` syscall.
    pub sys_open :: fn (path: ^i8, flags: i32, mode: i32) => syscall(SYS_OPEN, path.as(usize).as(u64), flags.as(u64), mode.as(u64), 0, 0, 0).as(i32)

    -- Closes a file descriptor using the Linux `close` syscall.
    pub sys_close :: fn (fd: i32) => syscall(SYS_CLOSE, fd.as(u64), 0, 0, 0, 0, 0).as(i32)

    -- Reads metadata for a path relative to a directory descriptor.
    pub sys_newfstatat :: fn (directory : i32,
                              path      : ^i8,
                              stat      : ^Stat,
                              flags     : i32) => syscall(SYS_NEWFSTATAT, directory.as(u64), path.as(usize).as(u64), stat.as(usize).as(u64), flags.as(u64), 0, 0).as(i32)

    -- Waits for events on file descriptors using the Linux `poll` syscall.
    pub sys_poll :: fn (fds: ^PollFd, nfds: usize, timeout_ms: i32) => syscall(SYS_POLL, fds.as(usize).as(u64), nfds.as(u64), timeout_ms.as(u64), 0, 0, 0).as(i32)

    -- Flushes file contents and metadata using the Linux `fsync` syscall.
    pub sys_fsync :: fn (fd: i32) => syscall(SYS_FSYNC, fd.as(u64), 0, 0, 0, 0, 0).as(i32)

    -- Removes a filesystem name using the Linux `unlink` syscall.
    pub sys_unlink :: fn (path: ^i8) => syscall(SYS_UNLINK, path.as(usize).as(u64), 0, 0, 0, 0, 0).as(i32)

    -- Applies a Linux `ioctl` request with a pointer argument.
    pub sys_ioctl :: fn (fd: i32, request: u64, arg: ^void) => syscall(SYS_IOCTL, fd.as(u64), request, arg.as(usize).as(u64), 0, 0, 0).as(i32)

    -- Creates a child process by duplicating the calling process.
    pub sys_fork :: fn () => syscall(SYS_FORK, 0, 0, 0, 0, 0, 0).as(i32)

    -- Replaces the calling process with an executable and argument vector.
    pub sys_execve :: fn (path: ^i8, arguments: ^^i8, environment: ^^i8) => syscall(SYS_EXECVE, path.as(usize).as(u64), arguments.as(usize).as(u64), environment.as(usize).as(u64), 0, 0, 0).as(i32)

    -- Terminates the calling process with the supplied status.
    pub sys_exit :: fn (status: i32) {
        _ := syscall(SYS_EXIT, status.as(u64), 0, 0, 0, 0, 0)
    }

    -- Waits for a child process to change state and writes its wait status.
    pub sys_waitpid :: fn (process_id: i32, status: ^i32, options: i32) => syscall(SYS_WAIT4, process_id.as(u64), status.as(usize).as(u64), options.as(u64), 0, 0, 0).as(i32)

}

on "linux" {

    test "file descriptor wrappers read and write the null device" {
        reader := sys_open(c"/dev/null", O_RDONLY, 0)
        assert reader >= 0,
            "Expected opening the null device for reading to succeed"
        defer _ := sys_close(reader)
        buffer : [4]u8
        assert sys_read(reader, buffer.data, buffer.bytes) == 0,
            "Expected the null device to return end of file"

        writer := sys_open(c"/dev/null", O_WRONLY, 0)
        assert writer >= 0,
            "Expected opening the null device for writing to succeed"
        defer _ := sys_close(writer)
        buffer[0] = 42
        assert sys_write(writer, buffer.data, buffer.bytes) == 4,
            "Expected the null device to accept all bytes"
    }

    test "file metadata and syscall errors" {
        metadata : Stat
        assert sys_newfstatat(AT_FDCWD, c"/dev/null", ^metadata, 0) == 0,
            "Expected metadata lookup to fill the native Stat structure"
        assert metadata.mode != 0 && metadata.nlink > 0,
            "Expected valid mode and link-count fields"
        assert sys_open(c"/dev/null/child", O_RDONLY, 0) == -1,
            "Expected a non-directory path component to fail"
        assert last_error() == ENOTDIR,
            "Expected syscall failures to expose the libc error code"
        assert sys_unlink(c"/dev/null/child") == -1,
            "Expected unlink through a non-directory to fail safely"
        assert last_error() == ENOTDIR,
            "Expected unlink to preserve the native error code"
        assert sys_fsync(-1) == -1,
            "Expected flushing an invalid descriptor to fail"
    }

    test "poll and terminal requests" {
        assert sys_poll(nil, 0, 0) == 0,
            "Expected an empty poll with no timeout to return immediately"
        descriptor := sys_open(c"/dev/null", O_RDONLY, 0)
        assert descriptor >= 0, "Expected opening the null device to succeed"
        defer _ := sys_close(descriptor)
        event := PollFd { fd: descriptor events: POLLIN revents: 0 }
        assert sys_poll(^event, 1, 0) == 1 && (event.revents & POLLIN) != 0,
            "Expected poll to report the null device as readable"
        size : WindowSize
        assert sys_ioctl(descriptor, TIOCGWINSZ, ^size) == -1,
            "Expected a terminal request on a non-terminal to fail"
    }

    test "fork exit and wait preserve child status" {
        child := sys_fork()
        assert child >= 0, "Expected fork to create a child process"
        on child == 0 => {
            sys_exit(37)
        }
        status : i32
        assert sys_waitpid(child, ^status, 0) == child,
            "Expected wait to return the child process ID"
        assert status == (37 << 8),
            "Expected the child's exit status to be preserved"
    }

    test "execve reports an invalid executable path" {
        arguments : [2]^i8 = [c"/dev/null/child", nil]
        assert sys_execve(arguments[0], arguments.data, nil) == -1,
            "Expected an invalid executable path to return without replacing "
            +"the process"
        assert last_error() == ENOTDIR,
            "Expected execve to expose the native path error"
    }

}
